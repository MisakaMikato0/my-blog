---
import Navbar from "@components/layout/Navbar.astro";
import NavMenuPanel from "@components/layout/NavMenuPanel.astro";
import { navBarConfig } from "@/config";
import { LinkPresets } from "@/constants/link-presets";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { title, description, lang } = Astro.props;

const navLinks = navBarConfig.links.map((item) => {
	if (typeof item === "number") return LinkPresets[item];
	return item;
});
---

<Layout title={title} description={description} lang={lang}>
	<slot slot="head" name="head"></slot>

	<!-- 悬浮导航：absolute 不占文档流，让全屏背景从视口顶部开始 -->
	<div
		id="top-row"
		class="pointer-events-none absolute left-0 right-0 top-0 z-50"
	>
		<div id="navbar-wrapper" class="pointer-events-auto bg-transparent">
			<Navbar></Navbar>
		</div>
	</div>

	<NavMenuPanel links={navLinks} />

	<!-- 全屏内容：不限制容器宽度，背景可铺满整个视口 -->
	<main id="swup-container" class="transition-swup-main">
		<slot />
	</main>
</Layout>
