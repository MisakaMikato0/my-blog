---
import Icon from "@components/common/Icon.astro";
import { getApiUrlList } from "@/utils/image-utils";

// 文章封面 API：随机图做背景，客户端按顺序重试，全部失败隐藏背景
const coverApis = getApiUrlList("api", "weather-widget");
---

<!--
	天气组件：基于 uapis.cn 天气接口（IP 自动定位）
	数据填充脚本与 weather-widget-script.js 逻辑保持一致，
	图标使用 lucide（轻量线性图标库），构建期内联 SVG，运行时按 weather_icon 切换显示。
-->
<section class="weather-widget" data-weather-init aria-label="天气预报">
	<!-- 背景图：文章封面 API（与 guide-card 视觉一致，低透明度 + hover 放大） -->
	{coverApis.length > 0 && (
		<div class="weather-widget__visual" aria-hidden="true">
			<img
				src={coverApis[0]}
				data-weather-cover
				data-api-urls={JSON.stringify(coverApis)}
				alt=""
				loading="lazy"
				decoding="async"
				referrerpolicy="no-referrer"
			/>
		</div>
	)}

	<!-- 加载状态 -->
	<div class="weather-widget__status weather-widget__status--loading" data-weather-loading>
		<div class="weather-widget__spinner" aria-hidden="true"></div>
		<span>加载中...</span>
	</div>

	<!-- 错误状态 -->
	<div class="weather-widget__status weather-widget__status--error weather-hidden" data-weather-error role="alert">
		<Icon name="lucide:triangle-alert" class="weather-widget__error-icon" is:inline />
		<span class="weather-widget__error-msg" data-error-message>加载失败</span>
		<button class="weather-widget__retry" type="button" data-retry-btn>
			<Icon name="lucide:refresh-cw" is:inline />重试
		</button>
	</div>

	<!-- 天气数据 -->
	<div class="weather-widget__content weather-hidden" data-weather-content>
		<div class="weather-widget__header">
			<div class="weather-widget__location">
				<Icon name="lucide:map-pin" class="weather-widget__loc-icon" is:inline />
				<span class="weather-widget__city" data-city>--</span>
				<span class="weather-widget__district" data-district>--</span>
			</div>
			<div class="weather-widget__big-icon" aria-hidden="true">
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="sun"><Icon name="lucide:sun" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud"><Icon name="lucide:cloud" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-sun"><Icon name="lucide:cloud-sun" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="wind"><Icon name="lucide:wind" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-rain"><Icon name="lucide:cloud-rain" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-lightning"><Icon name="lucide:cloud-lightning" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-hail"><Icon name="lucide:cloud-hail" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-drizzle"><Icon name="lucide:cloud-drizzle" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="cloud-snow"><Icon name="lucide:cloud-snow" is:inline /></span>
				<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon="snowflake"><Icon name="lucide:snowflake" is:inline /></span>
			</div>
		</div>

		<div class="weather-widget__temp-row">
			<span class="weather-widget__temp" data-temperature>--</span>
			<span class="weather-widget__unit">°C</span>
			<span class="weather-widget__desc" data-weather>--</span>
		</div>

		<div class="weather-widget__range">
			<span class="weather-widget__range-min"><span data-temp-min>--</span>°</span>
			<span class="weather-widget__range-divider">/</span>
			<span class="weather-widget__range-max"><span data-temp-max>--</span>°</span>
			<span class="weather-widget__update">
				<Icon name="lucide:clock" is:inline />
				<span data-report-time>--</span>
			</span>
			<button class="weather-widget__retry weather-widget__retry--refresh" type="button" data-retry-btn title="刷新天气" aria-label="刷新天气">
				<Icon name="lucide:refresh-cw" is:inline />
			</button>
		</div>

		<div class="weather-widget__extended" data-weather-extended>
			<div class="weather-widget__item">
				<Icon name="lucide:thermometer" is:inline />
				<span class="weather-widget__item-label">体感</span>
				<span class="weather-widget__item-value" data-feels-like>--°C</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:droplet" is:inline />
				<span class="weather-widget__item-label">湿度</span>
				<span class="weather-widget__item-value" data-humidity>--%</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:wind" is:inline />
				<span class="weather-widget__item-label">风力</span>
				<span class="weather-widget__item-value" data-wind>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:umbrella" is:inline />
				<span class="weather-widget__item-label">降水概率</span>
				<span class="weather-widget__item-value" data-pop>--%</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:sunrise" is:inline />
				<span class="weather-widget__item-label">日出</span>
				<span class="weather-widget__item-value" data-sunrise>--:--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:sunset" is:inline />
				<span class="weather-widget__item-label">日落</span>
				<span class="weather-widget__item-value" data-sunset>--:--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:eye" is:inline />
				<span class="weather-widget__item-label">能见度</span>
				<span class="weather-widget__item-value" data-visibility>--km</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:gauge" is:inline />
				<span class="weather-widget__item-label">气压</span>
				<span class="weather-widget__item-value" data-pressure>--hPa</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:sun-medium" is:inline />
				<span class="weather-widget__item-label">紫外线</span>
				<span class="weather-widget__item-value" data-uv>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:cloud-rain" is:inline />
				<span class="weather-widget__item-label">降水量</span>
				<span class="weather-widget__item-value" data-precipitation>--mm</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:cloud" is:inline />
				<span class="weather-widget__item-label">云量</span>
				<span class="weather-widget__item-value" data-cloud>--%</span>
			</div>
			<div class="weather-widget__item weather-widget__item--aqi">
				<Icon name="lucide:leaf" is:inline />
				<span class="weather-widget__item-label">空气质量</span>
				<span class="weather-widget__item-value">
					<span data-aqi>--</span>
					<span class="aqi-tag" data-aqi-category>--</span>
				</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:activity" is:inline />
				<span class="weather-widget__item-label">PM2.5</span>
				<span class="weather-widget__item-value" data-pm25>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:activity" is:inline />
				<span class="weather-widget__item-label">PM10</span>
				<span class="weather-widget__item-value" data-pm10>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:flask-conical" is:inline />
				<span class="weather-widget__item-label">O₃</span>
				<span class="weather-widget__item-value" data-o3>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:flask-conical" is:inline />
				<span class="weather-widget__item-label">NO₂</span>
				<span class="weather-widget__item-value" data-no2>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:flask-conical" is:inline />
				<span class="weather-widget__item-label">SO₂</span>
				<span class="weather-widget__item-value" data-so2>--</span>
			</div>
			<div class="weather-widget__item">
				<Icon name="lucide:flask-conical" is:inline />
				<span class="weather-widget__item-label">CO</span>
				<span class="weather-widget__item-value" data-co>--</span>
			</div>
		</div>
	</div>
</section>

<style>
	.weather-widget {
		--weather-fg: var(--guide-fg);
		--weather-bg: var(--guide-bg);
		--weather-border: var(--guide-border);
		--weather-accent: var(--guide-accent);
		--weather-muted: color-mix(in srgb, var(--weather-fg) 62%, transparent);
		--weather-line: color-mix(in srgb, var(--weather-fg) 18%, transparent);
		position: relative;
		margin-top: var(--guide-gap);
		border: 2px solid var(--weather-border);
		border-radius: var(--guide-radius);
		background: var(--weather-bg);
		color: var(--weather-fg);
		padding: clamp(1rem, 1.8vw, 1.6rem);
		overflow: hidden;
		isolation: isolate;
	}

	.weather-hidden {
		display: none !important;
	}

	/* ===== 背景图：文章封面 API（与 guide-card__visual 一致） ===== */
	.weather-widget__visual {
		position: absolute;
		inset: 0;
		z-index: -2;
		opacity: 0.16;
		pointer-events: none;
		overflow: hidden;
	}

	.weather-widget__visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 240ms ease, opacity 240ms ease;
	}

	.weather-widget:hover .weather-widget__visual img,
	.weather-widget:focus-within .weather-widget__visual img {
		transform: scale(1.06) translateX(1.5%);
		opacity: 0.55;
	}

	.weather-widget__status,
	.weather-widget__content {
		position: relative;
		z-index: 1;
	}

	/* ===== 状态：加载 / 错误 ===== */
	.weather-widget__status {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 6rem;
		font-size: 0.88rem;
		font-weight: 750;
		color: var(--weather-muted);
	}

	.weather-widget__spinner {
		width: 2rem;
		height: 2rem;
		border: 2px solid var(--weather-line);
		border-top-color: var(--weather-accent);
		border-radius: 50%;
		animation: weather-widget-spin 0.8s linear infinite;
	}

	@keyframes weather-widget-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.weather-widget__error-icon {
		color: #ef4444;
		font-size: 2rem;
	}

	.weather-widget__error-msg {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 100%;
	}

	.weather-widget__retry {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.4rem;
		padding: 0.375rem 0.85rem;
		border: 1px solid var(--weather-border);
		border-radius: 0.5rem;
		background: var(--weather-bg);
		color: var(--weather-fg);
		font-size: 0.78rem;
		font-weight: 850;
		cursor: pointer;
		transition:
			transform 160ms ease,
			background-color 160ms ease,
			color 160ms ease;
	}

	.weather-widget__retry:hover {
		transform: translateY(-1px);
		background: var(--weather-fg);
		color: var(--weather-bg);
	}

	.weather-widget__retry svg {
		width: 1em;
		height: 1em;
	}

	/* ===== 内容区 ===== */
	.weather-widget__content {
		display: flex;
		flex-direction: column;
		gap: clamp(0.9rem, 1.6vw, 1.3rem);
		animation: weather-widget-fade-in 0.5s ease both;
	}

	@keyframes weather-widget-fade-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 头部：位置 + 大图标 */
	.weather-widget__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.weather-widget__location {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.3rem;
		min-width: 0;
	}

	.weather-widget__loc-icon {
		color: var(--weather-accent);
		font-size: 1rem;
		flex: none;
	}

	.weather-widget__city,
	.weather-widget__district {
		font-size: clamp(0.95rem, 1.2vw, 1.1rem);
		font-weight: 800;
		line-height: 1.2;
	}

	.weather-widget__district {
		color: var(--weather-muted);
		font-weight: 650;
	}

	.weather-widget__big-icon {
		flex: none;
		font-size: clamp(2.4rem, 3.4vw, 3.2rem);
		color: var(--weather-accent);
		line-height: 1;
		animation: weather-widget-float 3s ease-in-out infinite;
	}

	@keyframes weather-widget-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.weather-widget__icon-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/* 温度行 */
	.weather-widget__temp-row {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.weather-widget__temp {
		font-size: clamp(2.4rem, 4vw, 3.4rem);
		font-weight: 950;
		line-height: 1;
	}

	.weather-widget__unit {
		font-size: clamp(0.9rem, 1.3vw, 1.1rem);
		font-weight: 750;
		color: var(--weather-muted);
		position: relative;
		top: -0.8rem;
	}

	.weather-widget__desc {
		margin-left: 0.4rem;
		font-size: clamp(1.1rem, 1.8vw, 1.5rem);
		font-weight: 800;
	}

	/* 最高/最低 + 更新时间 + 刷新 */
	.weather-widget__range {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.88rem;
		font-weight: 800;
	}

	.weather-widget__range-min {
		color: #3b82f6;
	}

	.weather-widget__range-max {
		color: #ef4444;
	}

	.weather-widget__range-divider {
		color: var(--weather-muted);
	}

	.weather-widget__update {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--weather-muted);
		opacity: 0.8;
	}

	.weather-widget__update svg {
		width: 0.9em;
		height: 0.9em;
	}

	.weather-widget__retry--refresh {
		display: inline-grid;
		place-items: center;
		margin-top: 0;
		padding: 0.28rem;
		border-radius: 50%;
		border: 1px solid var(--weather-line);
		font-size: 0.85rem;
		line-height: 1;
	}

	.weather-widget__retry--refresh svg {
		width: 0.9em;
		height: 0.9em;
	}

	/* 扩展数据网格 */
	.weather-widget__extended {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.55rem;
		border-top: 1px dashed var(--weather-line);
		padding-top: 0.9rem;
	}

	.weather-widget__item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--weather-line);
		border-radius: 0.6rem;
		background: color-mix(in srgb, var(--weather-fg) 4%, transparent);
		transition:
			border-color 160ms ease,
			transform 160ms ease;
	}

	.weather-widget__item:hover {
		border-color: color-mix(in srgb, var(--weather-accent) 55%, var(--weather-line));
		transform: translateY(-1px);
	}

	.weather-widget__item > svg {
		width: 1.1em;
		height: 1.1em;
		color: var(--weather-accent);
	}

	.weather-widget__item-label {
		font-size: 0.66rem;
		font-weight: 850;
		letter-spacing: 0.08em;
		color: var(--weather-muted);
	}

	.weather-widget__item-value {
		font-size: 0.88rem;
		font-weight: 900;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 空气质量单元格：数值 + 等级标签 */
	.weather-widget__item--aqi .weather-widget__item-value {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	/* AQI 等级标签 */
	.aqi-tag {
		display: inline-block;
		padding: 0.08rem 0.5rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 900;
		line-height: 1.4;
		white-space: nowrap;
	}

	.aqi-good {
		background: #22c55e;
		color: #fff;
	}

	.aqi-moderate {
		background: #eab308;
		color: #111;
	}

	.aqi-bad {
		background: #ef4444;
		color: #fff;
	}

	@media (max-width: 1200px) {
		.weather-widget__extended {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.weather-widget__extended {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		.weather-widget__header {
			flex-direction: column;
			align-items: flex-start;
		}

		.weather-widget__big-icon {
			align-self: flex-end;
			margin-top: -3.4rem;
		}

		.weather-widget__update {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.weather-widget__spinner,
		.weather-widget__big-icon,
		.weather-widget__content {
			animation: none;
		}
	}
</style>

<script>
	interface ForecastDay {
		sunrise?: string;
		sunset?: string;
		pop?: number | string;
	}

	interface WeatherData {
		city?: string;
		district?: string;
		temperature?: number | string;
		weather?: string;
		wind_direction?: string;
		wind_power?: string;
		humidity?: number | string;
		report_time?: string;
		temp_max?: number | string;
		temp_min?: number | string;
		weather_icon?: string;
		feels_like?: number | string;
		visibility?: number | string;
		pressure?: number | string;
		uv?: number | string;
		precipitation?: number | string;
		cloud?: number | string;
		forecast?: ForecastDay[];
		aqi?: number | string;
		aqi_category?: string;
		aqi_level?: number;
		air_pollutants?: Record<string, number | string | undefined>;
	}

	const city = undefined;
	const adcode = undefined;
	const CACHE_KEY = "weather_data_cache";
	const CACHE_DURATION = 1800000;
	const extended = true;

	const API_URL = "https://uapis.cn/api/v1/misc/weather?";

	// 天气图标映射（weather_icon 代码 → lucide 图标名，组件内已预渲染）
	const weatherIcons = {
		"100": "sun",
		"101": "cloud",
		"102": "cloud",
		"103": "cloud-sun",
		"104": "cloud",
		"200": "wind",
		"201": "cloud-rain",
		"202": "cloud-lightning",
		"203": "cloud-rain",
		"204": "cloud-hail",
		"205": "cloud-drizzle",
		"206": "cloud-lightning",
		"207": "cloud-snow",
		"208": "cloud-rain",
		"209": "cloud-rain",
		"210": "cloud-lightning",
	};

	function getWeatherIcon(weatherIcon: string) {
		return weatherIcons[weatherIcon] || "sun";
	}

	function readCache(key: string): WeatherData | null {
		try {
			const raw = localStorage.getItem(key);
			if (!raw) return null;
			const entry = JSON.parse(raw);
			if (!entry || typeof entry.timestamp !== "number") return null;
			if (Date.now() - entry.timestamp > CACHE_DURATION) return null;
			return entry.data;
		} catch {
			return null;
		}
	}

	// 获取天气数据 - 支持 IP 自动定位
	async function fetchWeather(): Promise<WeatherData> {
		const params = new URLSearchParams();
		if (adcode) {
			params.set("adcode", adcode);
		} else if (city) {
			params.set("city", city);
		}
		// 如果都没传，不传任何参数，让接口自动根据 IP 定位
		if (extended) {
			params.set("extended", "true");
		}
		// 添加 forecast=true 获取最高/最低温度
		params.set("forecast", "true");

		// 只有指定了城市或 adcode 时才缓存，IP 自动定位不缓存
		// 因为 IP 可能会变化（切换网络、VPN 等）
		const cacheKey = adcode ? `adcode_${adcode}` : city ? `city_${city}` : "";
		if (cacheKey) {
			const cached = readCache(CACHE_KEY + cacheKey);
			if (cached) return cached;
		}

		const url = API_URL + params.toString();
		const response = await fetch(url);

		if (!response.ok) {
			throw new Error(`请求失败: ${response.status}`);
		}

		const data = (await response.json()) as WeatherData;

		if (cacheKey) {
			try {
				localStorage.setItem(
					CACHE_KEY + cacheKey,
					JSON.stringify({ data, timestamp: Date.now() }),
				);
			} catch {
				// 忽略存储错误
			}
		}

		return data;
	}

	// 图标组件为构建期内联 SVG，无法运行时改 name，改为按代码切换显示
	function setWeatherIcon(container: HTMLElement, weatherIcon: string) {
		const iconName = getWeatherIcon(weatherIcon);
		container.querySelectorAll<HTMLElement>("[data-weather-icon]").forEach((el) => {
			el.classList.toggle("weather-hidden", el.dataset.icon !== iconName);
		});
	}

	// 封面背景图：按顺序重试 API，全部失败则隐藏背景层（天气数据不受影响）
	function initWeatherCover(container: HTMLElement) {
		const img = container.querySelector<HTMLImageElement>("[data-weather-cover]");
		if (!img) return;

		let urls: string[] = [];
		try {
			urls = JSON.parse(img.dataset.apiUrls || "[]");
		} catch {
			urls = [];
		}

		let index = 1; // 0 号已由服务端设为 src
		const onError = () => {
			if (index < urls.length) {
				img.addEventListener("error", onError, { once: true });
				img.src = urls[index];
				index += 1;
			} else {
				img.closest(".weather-widget__visual")?.classList.add("weather-hidden");
			}
		};

		if (img.complete) {
			if (img.naturalWidth === 0) onError();
		} else {
			img.addEventListener("error", onError, { once: true });
		}
	}

	// 更新 UI
	function updateUI(container: HTMLElement, data: WeatherData | null, error: string | null = null) {
		const loading = container.querySelector("[data-weather-loading]");
		const errorEl = container.querySelector("[data-weather-error]");
		const content = container.querySelector("[data-weather-content]");
		const errorMsg = container.querySelector("[data-error-message]");

		// 隐藏加载状态
		loading?.classList.add("weather-hidden");

		if (error) {
			// 如果有错误，显示错误信息，但不隐藏已有的内容
			errorEl?.classList.remove("weather-hidden");
			if (errorMsg) errorMsg.textContent = error;
			// 保留服务端渲染的内容（如果有的话）
			return;
		}

		if (!data) {
			// 如果没有数据也没有错误，不做任何操作
			return;
		}

		// 隐藏错误状态
		errorEl?.classList.add("weather-hidden");

		// 更新数据
		const setData = (selector: string, value: unknown) => {
			const el = container.querySelector(selector);
			if (el) el.textContent = value == null || value === "" ? "--" : String(value);
		};

		setData("[data-city]", data.city);
		setData("[data-district]", data.district);
		setData("[data-temperature]", data.temperature);
		setData("[data-weather]", data.weather);
		setData("[data-wind]", `${data.wind_direction} ${data.wind_power}`);
		setData("[data-humidity]", `${data.humidity}%`);
		setData("[data-report-time]", data.report_time);

		// 更新最高/最低温度
		setData("[data-temp-max]", data.temp_max != null ? String(data.temp_max) : "--");
		setData("[data-temp-min]", data.temp_min != null ? String(data.temp_min) : "--");

		// 更新天气图标
		setWeatherIcon(container, data.weather_icon ?? "");

		// 更新扩展数据
		const extendedSection = container.querySelector("[data-weather-extended]");
		if (extendedSection) {
			// 从 forecast 数组中获取日出日落时间
			const todayForecast = data.forecast && data.forecast.length > 0 ? data.forecast[0] : null;

			setData("[data-feels-like]", data.feels_like != null ? `${data.feels_like}°C` : "--°C");
			setData("[data-visibility]", data.visibility != null ? `${data.visibility}km` : "--km");
			setData("[data-pressure]", data.pressure != null ? `${data.pressure}hPa` : "--hPa");
			setData("[data-uv]", data.uv != null ? String(data.uv) : "--");
			setData("[data-precipitation]", data.precipitation != null ? `${data.precipitation}mm` : "--mm");
			setData("[data-cloud]", data.cloud != null ? `${data.cloud}%` : "--%");
			setData("[data-sunrise]", todayForecast?.sunrise || "--:--");
			setData("[data-sunset]", todayForecast?.sunset || "--:--");
			// 降水概率（从 forecast 获取）
			setData("[data-pop]", todayForecast?.pop != null ? `${todayForecast.pop}%` : "--%");

			// 空气质量
			const aqiEl = container.querySelector("[data-aqi]");
			const aqiCategoryEl = container.querySelector("[data-aqi-category]");
			if (data.aqi != null) {
				if (aqiEl) aqiEl.textContent = String(data.aqi);
				if (aqiCategoryEl) {
					aqiCategoryEl.textContent = data.aqi_category || "--";
					// 根据空气质量等级添加样式
					aqiCategoryEl.className = "aqi-tag";
					if (data.aqi_level === 1) aqiCategoryEl.classList.add("aqi-good");
					else if (data.aqi_level === 2) aqiCategoryEl.classList.add("aqi-moderate");
					else if ((data.aqi_level ?? 0) >= 3) aqiCategoryEl.classList.add("aqi-bad");
				}
			} else {
				if (aqiEl) aqiEl.textContent = "--";
				if (aqiCategoryEl) aqiCategoryEl.textContent = "--";
			}

			// 污染物浓度
			const pollutants = data.air_pollutants || {};
			setData("[data-pm25]", pollutants.pm25 != null ? `${pollutants.pm25}` : "--");
			setData("[data-pm10]", pollutants.pm10 != null ? `${pollutants.pm10}` : "--");
			setData("[data-o3]", pollutants.o3 != null ? `${pollutants.o3}` : "--");
			setData("[data-no2]", pollutants.no2 != null ? `${pollutants.no2}` : "--");
			setData("[data-so2]", pollutants.so2 != null ? `${pollutants.so2}` : "--");
			setData("[data-co]", pollutants.co != null ? `${pollutants.co}` : "--");
		}

		// 显示内容
		content?.classList.remove("weather-hidden");
	}

	// 初始化组件
	function initWidget(container: HTMLElement): (() => void) | undefined {
		if (container.dataset.weatherReady === "true") return;
		container.dataset.weatherReady = "true";

		initWeatherCover(container);

		const retryBtns = Array.from(container.querySelectorAll("[data-retry-btn]"));
		const content = container.querySelector("[data-weather-content]");
		const loading = container.querySelector("[data-weather-loading]");
		const errorEl = container.querySelector("[data-weather-error]");

		async function loadWeather() {
			// 显示加载状态，隐藏其他状态
			loading?.classList.remove("weather-hidden");
			errorEl?.classList.add("weather-hidden");
			content?.classList.add("weather-hidden");

			try {
				const data = await fetchWeather();
				updateUI(container, data);
			} catch (e) {
				updateUI(container, null, e.message || "获取天气信息失败");
			}
		}

		// 重试按钮 - 清除缓存后重新加载
		const onRetry = () => {
			const cacheKey = adcode ? `adcode_${adcode}` : city ? `city_${city}` : "ip_location";
			localStorage.removeItem(CACHE_KEY + cacheKey);
			loadWeather();
		};
		retryBtns.forEach((btn) => btn.addEventListener("click", onRetry));

		// 自动加载天气数据（基于用户浏览器 IP 定位）
		loadWeather();

		return () => {
			retryBtns.forEach((btn) => btn.removeEventListener("click", onRetry));
		};
	}

	// SWUP 无刷新切换页面时的初始化与清理
	const cleanups: Array<() => void> = [];
	function initWeatherWidgets() {
		document.querySelectorAll<HTMLElement>("[data-weather-init]").forEach((container) => {
			const cleanup = initWidget(container);
			if (cleanup) cleanups.push(cleanup);
		});
	}
	function cleanupWeatherWidgets() {
		cleanups.forEach((fn) => fn());
		cleanups.length = 0;
	}

	initWeatherWidgets();
	document.addEventListener("astro:page-load", initWeatherWidgets);
	document.addEventListener("swup:willReplaceContent", cleanupWeatherWidgets);
</script>
