# ── GitHub 贡献数据（部署时必填） ────────────────────

# GitHub Fine-grained Personal Access Token：供 Worker 动态查询 GitHub 贡献数据。
# 创建方式：GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens。
# 仅查询公开贡献数据时无需授予仓库权限；请设置有效期，并将 Token 仅作为 Cloudflare Secret 配置。
# 本地运行 wrangler dev 时可在此填写；不要提交真实 Token。
GITHUB_TOKEN=your_github_token_here

# ── Bangumi 个人访问令牌（可选） ────────────────────
# 用于构建时读取追番/书籍收藏。配置后可以读取私有收藏条目，
# 并获得更高的 API 限流配额。留空则只显示公开收藏。
# 创建方式：bgm.tv → 个人设置 → 开发 → 创建 Access Token
BANGUMI_TOKEN=your_bangumi_token_here

# ── AI 解卦 API（可选） ────────────────────────────

# 卜筮页面的 AI 解卦功能使用的兼容 Chat API Key。
# 未配置时，页面仍可生成提示词供手动使用。
AI_API_KEY=your_api_key_here

# ── AI 解卦（卜筮页面，可选） ────────────────────────
# 卜筮页面的 AI 白话解卦功能。API Key 只存在服务端（Worker 环境变量），不会下发到前端。
# 两种配置方式（优先 DEEPSEEK_*）：
# 1) 复用上面的 AI_API_KEY：不配置 DEEPSEEK_* 时使用默认兼容 API
# 2) 单独使用 DeepSeek 官方：注册 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
# 可选的 API 地址与模型覆盖（默认 ModelScope 的 deepseek-ai/DeepSeek-V4-Flash）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---- 相册后台管理（又拍云） ----
# 管理口令 Bearer Token（自己生成的随机字符串）
GALLERY_ADMIN_TOKEN=
# 又拍云云存储服务名（Bucket）
UPYUN_BUCKET=
# 又拍云操作员名称
UPYUN_OPERATOR=
# 又拍云操作员密码
UPYUN_OPERATOR_PASSWORD=
# 又拍云表单 API 密钥
UPYUN_FORM_API_SECRET=
# 又拍云 CDN 访问域名，如 https://img.example.com
UPYUN_CDN_HOST=

# ---- 动态管理后台（数据与图片同样走又拍云） ----
# 管理口令 Bearer Token（自己生成的随机字符串，与相册后台相互独立）
DYNAMIC_ADMIN_TOKEN=

# ---- IndexNow（可选） ----------------------------------------
# 用于主动推送 URL 给 Bing/Yandex/Seznam/Naver 等搜索引擎
# 密钥需与 public/{key}.txt 文件名一致，文件内容为该密钥本身
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=your_indexnow_key_here
