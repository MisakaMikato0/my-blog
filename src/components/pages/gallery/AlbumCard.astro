---
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	id: string;
	name: string;
	cover: string;
	photos: string[]; // 前3张照片，用于堆叠展示
	description?: string;
	date?: string;
	location?: string;
	tags?: string[];
	photoCount: number;
}

const {
	id,
	name,
	cover,
	photos,
	date,
	location,
	tags,
	photoCount,
} = Astro.props;

const displayPhotos = photos.slice(0, 3);
// 补齐到3张（不足时用cover补）
while (displayPhotos.length < 3) {
	displayPhotos.push(cover || "");
}

const rotations = [-3, 5, -2]; // 三张照片的旋转角度
const offsets = [0, 4, 8]; // 每张照片的偏移量（px）
---

<a
  href={url(`/gallery/${id}/`)}
  data-tags={tags?.join(",") || ""}
  class="album-card group"
>
  <!-- 堆叠照片区域 -->
  <div class="polaroid-stack">
    {displayPhotos.map((src, i) => (
      <div
        class="polaroid-photo"
        style={`--polaroid-rotate: ${rotations[i]}deg; --polaroid-offset: ${offsets[i]}px; z-index: ${3 - i};`}
      >
        {src ? (
          <img
            src={src}
            alt={i === 0 ? name : `${name} ${i + 1}`}
            class="polaroid-img"
            loading="lazy"
            decoding="async"
            width="400"
            height="300"
          />
        ) : (
          <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
            <span class="text-gray-400 text-3xl">📷</span>
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- 照片数角标 -->
  <div class="album-card-badge">
    {photoCount} {i18n(I18nKey.galleryPhotos)}
  </div>

  <!-- 信息区域（悬停展开） -->
  <div class="polaroid-details">
    <h3 class="polaroid-title">{name}</h3>
    <div class="polaroid-meta">
      {date && <span>{date}</span>}
      {location && (
        <span class="polaroid-location">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 010-5 2.5 2.5 0 010 5z"/></svg>
          {location}
        </span>
      )}
    </div>
    {tags && tags.length > 0 && (
      <div class="polaroid-tags">
        {tags.slice(0, 4).map((tag) => (
          <span class="polaroid-tag">{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>

<!-- 样式已迁移至 src/styles/pages/gallery.css -->
