---
import type { HeroMosaicConfig } from "@/types/config";
import { createHeroTileLayout } from "@/utils/home-hero-motion";

interface Props {
	desktopImage: string;
	mobileImage: string;
	images?: string[];
	config: HeroMosaicConfig;
}

const { desktopImage, mobileImage, images, config } = Astro.props;
const candidates = images && images.length > 0 ? images : [desktopImage];
const tiles = createHeroTileLayout(config);
const mosaicStyle = [
	`--home-hero-mosaic-image-mobile: url("${mobileImage}")`,
	`--home-hero-mosaic-columns: ${config.columns}`,
	`--home-hero-mosaic-rows: ${config.rows}`,
].join(";");
---

<div class="home-hero__visual" style={mosaicStyle} aria-hidden="true">
	<picture class="home-hero__backdrop" data-hero-backdrop>
		<source media="(max-width: 768px)" srcset={mobileImage} />
		<img
			class="home-hero__backdrop-image"
			alt=""
			width="3000"
			height="1500"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
	</picture>

	<div class="home-hero__mosaic-frame" data-hero-mosaic>
		<div class="home-hero__mosaic-grid">
			{tiles.map((tile) => (
				<span
					class:list={[
						"home-hero__mosaic-tile",
						{ "is-idle-visible": tile.initiallyVisible },
					]}
					data-hero-tile
					data-row={tile.row}
					data-column={tile.column}
					data-order={tile.order}
					data-offset-x={tile.offsetX}
					data-offset-y={tile.offsetY}
					data-rotation={tile.rotation}
					data-scale={tile.scale}
					data-blur={tile.blur}
					data-idle-visible={String(tile.initiallyVisible)}
					style={`left: ${(tile.column / config.columns) * 100}%; top: ${(tile.row / config.rows) * 100}%; width: ${100 / config.columns}%; height: ${100 / config.rows}%; z-index: ${config.idleVisible - tile.idleDepth}; --home-hero-tile-column: ${tile.column}; --home-hero-tile-row: ${tile.row}; --home-hero-tile-bg-x: ${(tile.column / Math.max(1, config.columns - 1)) * 100}%; --home-hero-tile-bg-y: ${(tile.row / Math.max(1, config.rows - 1)) * 100}%; --home-hero-tile-x: ${tile.offsetX}%; --home-hero-tile-y: ${tile.offsetY}%; --home-hero-tile-rotation: ${tile.rotation}deg; --home-hero-tile-scale: ${tile.scale}; --home-hero-tile-blur: ${tile.blur}px;`}
				>
					<span class="home-hero__mosaic-tile-image"></span>
				</span>
			))}
		</div>
		<picture class="home-hero__mosaic-complete" data-hero-mosaic-complete>
			<source media="(max-width: 768px)" srcset={mobileImage} />
			<img alt="" width="3000" height="1500" decoding="async" />
		</picture>
	</div>

	<script is:inline define:vars={{ images: candidates, columns: config.columns, rows: config.rows }}>
		(function () {
			const picked = images[Math.floor(Math.random() * images.length)];
			const visual = document.currentScript?.parentElement;
			if (!visual || !picked) return;
			// 马赛克碎片背景 + 完成图 + 兜底大图统一换成随机选中的图
			visual.style.setProperty(
				"--home-hero-mosaic-image",
				`url("${picked}")`,
			);
			const backdropImage = visual.querySelector(
				".home-hero__backdrop-image",
			);
			if (backdropImage) backdropImage.src = picked;
			const completeImage = visual.querySelector(
				".home-hero__mosaic-complete img",
			);
			if (completeImage) completeImage.src = picked;
			// 居中 cover 分块：按图片实际宽高比铺满拼图框（宽图裁左右、窄图裁上下），
			// 每个碎片用像素级 background-position 显示 cover 整图的对应网格区域，
			// 保证碎片拼接结果 = 完成图（object-fit: cover）与兜底大图完全一致。
			const applyCoverTiles = () => {
				const frame = visual.querySelector(".home-hero__mosaic-frame");
				const naturalWidth = backdropImage?.naturalWidth ?? 0;
				const naturalHeight = backdropImage?.naturalHeight ?? 0;
				if (!frame || !naturalWidth || !naturalHeight) return;
				const frameRect = frame.getBoundingClientRect();
				const frameWidth = frameRect.width;
				const frameHeight = frameRect.height;
				if (!frameWidth || !frameHeight) return;
				const scale = Math.max(
					frameWidth / naturalWidth,
					frameHeight / naturalHeight,
				);
				const imageWidth = naturalWidth * scale;
				const imageHeight = naturalHeight * scale;
				// 居中 cover：图片左上角相对拼图框的偏移（负值）
				const baseX = (imageWidth - frameWidth) / 2;
				const baseY = (imageHeight - frameHeight) / 2;
				visual
					.querySelectorAll("[data-hero-tile]")
					.forEach((tile) => {
						const image = tile.querySelector(
							".home-hero__mosaic-tile-image",
						);
						if (!image) return;
						const col = Number(tile.dataset.column ?? 0);
						const row = Number(tile.dataset.row ?? 0);
						image.style.backgroundSize = `${imageWidth.toFixed(
							2,
						)}px ${imageHeight.toFixed(2)}px`;
						image.style.backgroundPosition = `${(
							baseX +
							(col * frameWidth) / columns
						).toFixed(2)}px ${(
							baseY +
							(row * frameHeight) / rows
						).toFixed(2)}px`;
					});
			};
			if (backdropImage?.complete && backdropImage.naturalWidth > 0) {
				applyCoverTiles();
			} else {
				backdropImage?.addEventListener("load", applyCoverTiles, {
					once: true,
				});
			}
			// 窗口尺寸变化后重算分块（拼图框宽度随 vw 变化）
			let resizeTimer = 0;
			window.addEventListener(
				"resize",
				() => {
					window.clearTimeout(resizeTimer);
					resizeTimer = window.setTimeout(applyCoverTiles, 120);
				},
				{ passive: true },
			);
		})();
	</script>
</div>
