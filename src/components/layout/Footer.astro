---
import Icon from "@components/common/Icon.astro";
import { footerConfig, homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
const { socialLinks, beian, poweredBy } = footerConfig;

const posts = await getSortedPosts();
const latestPost = posts.reduce((latest, post) => {
	if (!latest) return post;
	return post.data.published > latest.data.published ? post : latest;
}, posts[0]);

const lastPostDate = latestPost
	? latestPost.data.published.toISOString()
	: null;
const runningDaysText =
	siteConfig.lang === "zh_CN"
		? "大结界已存在 {days} 天"
		: i18n(I18nKey.footerRunningDays);
const lastUpdateText = i18n(I18nKey.footerLastUpdate);
const todayText = i18n(I18nKey.today);
const isExternalLink = (href: string) => !/^(mailto:|tel:)/i.test(href);
---

<footer class="site-footer" aria-label="站点页脚">
	<div class="site-footer__ambient" aria-hidden="true"></div>
	<div class="site-footer__inner">
		<div class="site-footer__primary">
			<section class="site-footer__brand" aria-labelledby="footer-brand-title">
				<p class="site-footer__eyebrow">
					<span class="site-footer__status-dot"></span>
					幻想乡结界稳定 / 2026
				</p>
				<div class="site-footer__brand-row">
					<div class="site-footer__brand-mark" aria-hidden="true">幽</div>
					<h2 id="footer-brand-title" class="site-footer__brand-title" aria-label="白玉楼">
						<span>白</span><span>玉</span><span>楼</span>
					</h2>
				</div>
				<p class="site-footer__tagline">记录技术、AI 与幻想乡边缘的微小闪光。</p>
				<p class="site-footer__code-line">
					<span>YUYUKO.LOG</span><span aria-hidden="true">///</span><span>KEEP WALKING</span>
				</p>
			</section>

			<section class="site-footer__contact" aria-labelledby="footer-contact-title">
				<p class="site-footer__eyebrow" id="footer-contact-title">幻想乡联络处 / 留下坐标</p>
				<ul class="site-footer__social-list">
					{socialLinks.map((link) => (
						<li>
							<a
								class="site-footer__social-link"
								data-tooltip={link.label}
								aria-label={link.label}
								target={isExternalLink(link.href) ? "_blank" : undefined}
								rel={isExternalLink(link.href) ? "noreferrer" : undefined}
								href={link.href}
							>
								<Icon name={link.icon} is:inline />
							</a>
						</li>
					))}
				</ul>
				<nav class="site-footer__utility-links" aria-label="站点工具">
					<a target="_blank" rel="noreferrer" href={url("sitemap-index.xml")}>
						<Icon name="material-symbols:map-outline" is:inline />Sitemap
					</a>
					<span aria-hidden="true">/</span>
					<a target="_blank" rel="noreferrer" href={url("rss/")}>
						<Icon name="material-symbols:rss-feed-rounded" is:inline />RSS
					</a>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						onclick="window.openPrivacyModal && window.openPrivacyModal()"
						type="button"
					>
						<Icon name="material-symbols:shield-outline" is:inline />隐私政策
					</button>
					<span aria-hidden="true">/</span>
					<button
						class="site-footer__utility-button"
						onclick="window.openUserAgreementModal && window.openUserAgreementModal()"
						type="button"
					>
						<Icon name="material-symbols:description-outline" is:inline />用户协议
					</button>
				</nav>
			</section>
		</div>

		<div class="site-footer__lower">
			<div class="site-footer__legal">
				<div class="site-footer__copyright-row">
					<p class="site-footer__copyright">&copy; <span id="copyright-year">{currentYear}</span> {homeConfig.name}</p>
					<span class="site-footer__copyright-divider" aria-hidden="true">·</span>
					<p class="site-footer__powered-by">
						{poweredBy.map((item, index) => (
							<>
								<span>{item.label}</span>
								<a target="_blank" rel="noreferrer" href={item.href}>{item.name}</a>
								{index < poweredBy.length - 1 && <span aria-hidden="true"> · </span>}
							</>
						))}
					</p>
				</div>
				{(beian.icp || beian.police) && (
					<div class="site-footer__beian">
						{beian.icp && (
							<a target="_blank" rel="noreferrer" href={beian.icpUrl}>{beian.icp}</a>
						)}
						{beian.icp && beian.police && <span aria-hidden="true">·</span>}
						{beian.police && (
							<a class="site-footer__police-link" target="_blank" rel="noreferrer" href={beian.policeUrl}>
								<img src={beian.policeIcon} alt="" />{beian.police}
							</a>
						)}
					</div>
				)}
			</div>

			<div class="site-footer__status" aria-label="站点状态">
				<p class="site-footer__status-line">
					<Icon name="material-symbols:calendar-clock-outline" is:inline />
					<span id="footer-running-days" data-template={runningDaysText}>--</span>
				</p>
				<p class="site-footer__status-line">
					<Icon name="mingcute:heartbeat-line" is:inline />
					<span id="footer-last-update" data-template={lastUpdateText} data-today={todayText}>--</span>
				</p>
			</div>
		</div>
	</div>
</footer>

<script is:inline define:vars={{ siteStartDate, lastPostDate }}>
	function updateFooterStats() {
		const today = new Date();
		const startDate = new Date(siteStartDate);
		const diffTime = Math.abs(today.getTime() - startDate.getTime());
		const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

		const runningDaysEl = document.getElementById("footer-running-days");
		if (runningDaysEl) {
			const template = runningDaysEl.dataset.template || "已运行 {days} 天";
			runningDaysEl.textContent = template.replace("{days}", diffDays.toString());
		}

		const lastUpdateEl = document.getElementById("footer-last-update");
		if (lastUpdateEl && lastPostDate) {
			const lastPost = new Date(lastPostDate);
			const timeSinceLastPost = Math.abs(today.getTime() - lastPost.getTime());
			const daysSinceLastUpdate = Math.floor(timeSinceLastPost / (1000 * 60 * 60 * 24));
			const template = lastUpdateEl.dataset.template || "最后更新于 {days} 天前";
			const todayText = lastUpdateEl.dataset.today || "今天";
			lastUpdateEl.textContent = daysSinceLastUpdate === 0
				? todayText
				: template.replace("{days}", daysSinceLastUpdate.toString());
		}
	}

	updateFooterStats();

	if (!window.__footer_listener) {
		window.__footer_listener = true;
		document.addEventListener("astro:page-load", () => {
			setTimeout(updateFooterStats, 100);
		});
	}
</script>
