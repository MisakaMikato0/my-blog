---
import Icon from "@components/common/Icon.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import AlbumCard from "@/components/pages/gallery/AlbumCard.astro";
import DynamicAlbums from "@/components/pages/gallery/DynamicAlbums.svelte";
import GalleryBackground from "@/components/pages/gallery/GalleryBackground.svelte";
import NetworkAlbum from "@/components/pages/gallery/NetworkAlbum.svelte";
import { coverImageConfig, galleryConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import {
	getAlbumCover,
	readAlbumCaptions,
	scanAlbumPhotos,
} from "@/utils/gallery-utils";
import { getApiUrlList } from "@/utils/image-utils";
import { url } from "@/utils/url-utils";
import "@/styles/pages/gallery.css";

if (!siteConfig.pages.gallery) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.gallery);
const description = i18n(I18nKey.galleryDescription);

const albums = galleryConfig.albums.map((album) => {
	const photos = scanAlbumPhotos(album.id);
	const cover = getAlbumCover(album, photos);
	const captions = readAlbumCaptions(album.id);
	const captionTexts = Object.values(captions).join(" ");
	return { ...album, cover, photos, photoCount: photos.length, captionTexts };
});

const allTags = [...new Set(albums.flatMap((a) => a.tags || []))].sort();

// 模糊背景：优先使用第一个相册封面，其次文章封面随机图接口，最后本地兜底
const bgPreferred = albums[0]?.cover || "";
const bgApiUrls = getApiUrlList(undefined, "gallery");
const bgFallback =
	coverImageConfig.randomCoverImage.fallback || "/assets/images/aut.webp";

const tabs = [
	{
		id: "local",
		name: i18n(I18nKey.galleryLocalAlbum),
		icon: "material-symbols:folder-rounded",
	},
	{
		id: "network",
		name: i18n(I18nKey.galleryNetworkAlbum),
		icon: "material-symbols:wallpaper",
	},
];
---

<MainGridLayout title={title} description={description}>
  <GalleryBackground
    client:load
    preferredSrc={bgPreferred}
    apiUrls={bgApiUrls}
    fallback={bgFallback}
  />
  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="gallery-panel z-10 px-9 py-6 relative w-full">
      <div class="mb-4 flex items-center justify-between gap-4">
        <PageTitle title={title} variant="stacked" />
        <a
          href={url("/gallery/admin/")}
          class="gallery-admin-entry inline-flex shrink-0 items-center justify-center rounded-lg w-9 h-9 text-neutral-500 hover:text-(--primary) dark:text-neutral-400 dark:hover:text-(--primary) transition-colors"
          title={i18n(I18nKey.galleryAdmin)}
          aria-label={i18n(I18nKey.galleryAdmin)}
          data-gallery-admin-entry
          style="display:none"
        >
          <Icon name="material-symbols:manage-accounts-rounded" class="text-xl" />
        </a>
      </div>

      <div class="border-b border-(--line-divider) mb-3 relative">
        <div class="overflow-x-auto" data-tab-scroll-container>
          <nav class="flex min-w-max space-x-8" aria-label="Gallery Tabs" data-gallery-tab-nav>
            <div class="gallery-tab-indicator" data-gallery-tab-indicator></div>
            {tabs.map((tab) => (
              <button
                class:list={[
                  "gallery-tab-btn whitespace-nowrap py-4 px-1 font-medium text-sm transition-colors duration-200 flex items-center gap-2",
                  {
                    "gallery-tab-btn-active": tab.id === "local",
                    "gallery-tab-btn-inactive": tab.id !== "local"
                  }
                ]}
                data-gallery-tab={tab.id}
                type="button"
              >
                <Icon name={tab.icon} class="text-[1.1rem]" />
                {tab.name}
              </button>
            ))}
          </nav>
        </div>
      </div>

      <div data-gallery-section="local">
        <!-- 搜索框 -->
        <div class="gallery-search-wrapper">
          <div class="gallery-search-input-group">
            <Icon name="material-symbols:search-rounded" class="gallery-search-icon" />
            <input
              type="text"
              class="gallery-search-input"
              placeholder={i18n(I18nKey.gallerySearchPlaceholder)}
              data-gallery-search
              aria-label={i18n(I18nKey.gallerySearch)}
            />
            <button
              class="gallery-search-clear"
              data-gallery-search-clear
              type="button"
              aria-label="Clear search"
              style="display:none"
            >
              <Icon name="material-symbols:close-rounded" />
            </button>
          </div>
        </div>

        {albums.length > 0 && allTags.length > 0 && (
          <div class="tools-tab-wrapper">
            <div class="tools-tab-pill" data-gallery-filter>
              <div class="tools-tab-indicator gallery-filter-indicator" style="opacity:0;"></div>
              <button
                data-tag="all"
                class="tools-tab-btn tools-tab-btn-active"
              >
                {i18n(I18nKey.all)}
              </button>
              {allTags.map((tag) => (
                <button
                  data-tag={tag}
                  class="tools-tab-btn tools-tab-btn-inactive"
                >
                  {tag}
                </button>
              ))}
            </div>
          </div>
        )}

        <div
          class="album-grid"
          data-album-grid
          data-static-count={albums.length}
        >
          {albums.map((album) => (
            <AlbumCard
              id={album.id}
              name={album.name}
              cover={album.cover}
              photos={album.photos}
              description={album.description}
              date={album.date}
              location={album.location}
              tags={album.tags}
              photoCount={album.photoCount}
            />
          ))}
          <DynamicAlbums client:load />
        </div>
        <div
          class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500"
          style={`display:${albums.length === 0 ? "flex" : "none"}`}
          data-album-empty
        >
          <Icon name="material-symbols:photo-library" class="text-6xl mb-4 opacity-50" />
          <p class="text-lg">{i18n(I18nKey.galleryNoAlbums)}</p>
        </div>
        <div
          class="flex flex-col items-center justify-center py-16 text-neutral-400 dark:text-neutral-500"
          style="display:none"
          data-album-search-empty
        >
          <Icon name="material-symbols:search-off-rounded" class="text-6xl mb-4 opacity-50" />
          <p class="text-lg">{i18n(I18nKey.gallerySearchNoResults)}</p>
        </div>
      </div>

      <div data-gallery-section="network" class="hidden">
        <NetworkAlbum client:load />
      </div>
    </div>
  </div>

  <!-- 标签筛选 + 搜索 + tab 切换 JS -->
  <script>
    // @ts-nocheck - 内联 UI 脚本，保持纯 JS，跳过 TS 严格 DOM 类型检查
    (function () {
      /* ---- Tab 切换 ---- */
      var tabNav = document.querySelector("[data-gallery-tab-nav]");
      var tabBtns = tabNav ? Array.from(tabNav.querySelectorAll("[data-gallery-tab]")) : [];
      var indicator = tabNav ? tabNav.querySelector("[data-gallery-tab-indicator]") : null;
      var sections = {
        local: document.querySelector('[data-gallery-section="local"]'),
        network: document.querySelector('[data-gallery-section="network"]'),
      };

      function updateTabIndicator(btn) {
        if (!indicator || !tabNav) return;
        var navRect = tabNav.getBoundingClientRect();
        var btnRect = btn.getBoundingClientRect();
        indicator.style.left = btnRect.left - navRect.left + "px";
        indicator.style.width = btnRect.width + "px";
      }

      tabBtns.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.dataset.galleryTab;
          tabBtns.forEach(function (b) {
            b.classList.remove("gallery-tab-btn-active");
            b.classList.add("gallery-tab-btn-inactive");
          });
          btn.classList.remove("gallery-tab-btn-inactive");
          btn.classList.add("gallery-tab-btn-active");
          updateTabIndicator(btn);
          if (sections.local) {
            sections.local.classList.toggle("hidden", id !== "local");
          }
          if (sections.network) {
            sections.network.classList.toggle("hidden", id !== "network");
          }
        });
      });

      function initTabIndicator() {
        var active = tabNav ? tabNav.querySelector(".gallery-tab-btn-active") : null;
        if (active) updateTabIndicator(active);
      }
      initTabIndicator();
      document.addEventListener("astro:page-load", initTabIndicator);

      /* ---- 搜索 ---- */
      var searchInput = document.querySelector("[data-gallery-search]");
      var searchClear = document.querySelector("[data-gallery-search-clear]");
      var cardContainer = document.querySelector("[data-album-grid]");
      var searchEmpty = document.querySelector("[data-album-search-empty]");
      var filterEmpty = document.querySelector("[data-album-empty]");
      var searchTimer = null;

      function doSearch() {
        if (!searchInput || !cardContainer) return;
        var query = searchInput.value.trim().toLowerCase();
        var hasQuery = query.length > 0;

        // 清除按钮显隐
        if (searchClear) {
          searchClear.style.display = hasQuery ? "" : "none";
        }

        // 获取当前选中的标签
        var activeFilter = document.querySelector("[data-gallery-filter] [data-tag].tools-tab-btn-active");
        var selectedTag = activeFilter ? activeFilter.dataset.tag : "all";

        var cards = cardContainer.querySelectorAll(".album-card");
        var visibleCount = 0;

        cards.forEach(function (card) {
          var searchText = (card.dataset.search || "").toLowerCase();
          var tags = (card.dataset.tags || "").split(",");

          var matchesTag = selectedTag === "all" || (selectedTag && tags.includes(selectedTag));
          var matchesSearch = !hasQuery || searchText.includes(query);

          if (matchesTag && matchesSearch) {
            card.style.display = "";
            card.classList.remove("gallery-card-fade-in");
            void card.offsetHeight;
            card.classList.add("gallery-card-fade-in");
            visibleCount++;
          } else {
            card.style.display = "none";
            card.classList.remove("gallery-card-fade-in");
          }
        });

        // 空态切换
        var noResults = hasQuery && visibleCount === 0;
        if (searchEmpty) searchEmpty.style.display = noResults ? "flex" : "none";
        if (filterEmpty) {
          var staticCount = Number(cardContainer.dataset.staticCount || 0);
          filterEmpty.style.display = (staticCount === 0 && !noResults) ? "flex" : "none";
        }
      }

      if (searchInput) {
        searchInput.addEventListener("input", function () {
          if (searchTimer) clearTimeout(searchTimer);
          searchTimer = setTimeout(doSearch, 250);
        });
      }

      if (searchClear) {
        searchClear.addEventListener("click", function () {
          if (searchInput) {
            searchInput.value = "";
            searchInput.focus();
          }
          doSearch();
        });
      }

      // 搜索初始化时从 data-search 属性读数据
      function initSearchData() {
        if (!cardContainer) return;
        cardContainer.querySelectorAll(".album-card").forEach(function (card) {
          // 如果还没有 data-search，从卡片内容构造
          if (!card.dataset.search) {
            var name = card.querySelector(".polaroid-title")?.textContent || "";
            var meta = card.querySelector(".polaroid-meta")?.textContent || "";
            var tags = card.dataset.tags || "";
            card.dataset.search = name + " " + meta + " " + tags;
          }
        });
      }
      initSearchData();
      document.addEventListener("astro:page-load", initSearchData);

      /* ---- 标签筛选（继承现有逻辑，增加搜索叠加） ---- */
      var filterContainer = document.querySelector("[data-gallery-filter]");
      if (filterContainer) {
        filterContainer.addEventListener("click", function (e) {
          var target = e.target;
          var btn = target && target.closest ? target.closest("[data-tag]") : null;
          if (!btn || btn.classList.contains("tools-tab-btn-active")) return;

          var filters = filterContainer.querySelectorAll("[data-tag]");
          filters.forEach(function (f) {
            f.classList.remove("tools-tab-btn-active");
            f.classList.add("tools-tab-btn-inactive");
            f.disabled = false;
          });
          btn.classList.remove("tools-tab-btn-inactive");
          btn.classList.add("tools-tab-btn-active");
          btn.disabled = true;

          // 更新指示器
          var indicator2 = filterContainer.querySelector(".gallery-filter-indicator");
          if (indicator2) {
            updateFilterIndicator(filterContainer, btn);
          }

          // 重新搜索（叠加标签筛选）
          doSearch();
        });

        function updateFilterIndicator(container, button) {
          var indicator2 = container.querySelector(".gallery-filter-indicator");
          if (!indicator2) return;
          var containerRect = container.getBoundingClientRect();
          var btnRect = button.getBoundingClientRect();
          indicator2.style.left = btnRect.left - containerRect.left + "px";
          indicator2.style.width = btnRect.width + "px";
          indicator2.style.opacity = "1";
        }

        // 初始化 filter 指示器
        function initFilterIndicator() {
          var allBtn = filterContainer.querySelector('[data-tag="all"]');
          if (allBtn) updateFilterIndicator(filterContainer, allBtn);
        }
        initFilterIndicator();
        document.addEventListener("astro:page-load", initFilterIndicator);
      }

      /* ---- 管理入口显隐 ---- */
      function updateAdminEntryVisibility() {
        var entry = document.querySelector("[data-gallery-admin-entry]");
        if (!entry) return;
        var hasToken = false;
        try {
          hasToken = !!sessionStorage.getItem("gallery-admin-token");
        } catch (e) {
          hasToken = false;
        }
        entry.style.display = hasToken ? "" : "none";
      }

      updateAdminEntryVisibility();
      document.addEventListener("astro:page-load", updateAdminEntryVisibility);
    })();
  </script>

  <!-- 相册卡片入场动效（gsap） -->
  <script>
    import gsap from "gsap";

    const prefersReducedMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = () => window.matchMedia("(max-width: 768px)").matches;

    const entered = new WeakSet<Element>();
    let localObserver: MutationObserver | null = null;
    let networkObserver: MutationObserver | null = null;

    function shouldAnimate(): boolean {
      return !prefersReducedMotion() && !isMobile();
    }

    function animateCards(container: HTMLElement, selector: string): void {
      if (!shouldAnimate()) return;
      const targets = Array.from(
        container.querySelectorAll<HTMLElement>(selector),
      ).filter((el) => !entered.has(el));
      if (targets.length === 0) return;
      targets.forEach((el) => entered.add(el));

      gsap.fromTo(
        targets,
        { opacity: 0, y: 30, filter: "blur(10px)" },
        {
          opacity: 1,
          y: 0,
          filter: "blur(0px)",
          duration: 0.6,
          delay: 0.15,
          stagger: 0.12,
          ease: "power2.out",
          overwrite: true,
          onComplete() {
            gsap.set(targets, { clearProps: "transform,opacity,filter" });
          },
        },
      );
    }

    function initGalleryEntrance(): void {
      localObserver?.disconnect();
      networkObserver?.disconnect();

      const localSection = document.querySelector<HTMLElement>(
        '[data-gallery-section="local"]',
      );
      const networkSection = document.querySelector<HTMLElement>(
        '[data-gallery-section="network"]',
      );

      if (localSection) {
        animateCards(localSection, ".album-card");
        localObserver = new MutationObserver(() =>
          animateCards(localSection, ".album-card"),
        );
        localObserver.observe(localSection, {
          childList: true,
          subtree: true,
        });
      }

      if (networkSection) {
        networkObserver = new MutationObserver(() => {
          if (networkSection.classList.contains("hidden")) return;
          animateCards(networkSection, ".image-item");
        });
        networkObserver.observe(networkSection, {
          childList: true,
          subtree: true,
        });
      }
    }

    if (!window.__galleryEntranceReady) {
      window.__galleryEntranceReady = true;
      document.addEventListener("astro:page-load", initGalleryEntrance);
    }
    initGalleryEntrance();
  </script>
</MainGridLayout>
