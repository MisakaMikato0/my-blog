# ── Cloudflare 凭证（必填） ──────────────────────────
# ⚠️ Cloudflare 凭证放在 .env.cf（而非 .env），避免 wrangler CLI 把
#    CLOUDFLARE_API_TOKEN 当作自己的认证导致 login/dev 冲突。
#    参考模板：.env.cf.example

# ── 以下变量同时被构建脚本与 wrangler dev 读取，放 .env 无冲突 ──

# ── GitHub 贡献数据（部署时必填） ────────────────────

# GitHub Fine-grained Personal Access Token：供 Worker 动态查询 GitHub 贡献数据。
# 创建方式：GitHub Settings → Developer settings → Personal access tokens → Fine-grained tokens。
# 仅查询公开贡献数据时无需授予仓库权限；请设置有效期，并将 Token 仅作为 Cloudflare Secret 配置。
# 本地运行 wrangler dev 时可在此填写；不要提交真实 Token。
GITHUB_TOKEN=your_github_token_here

# ── Bangumi 个人访问令牌（可选） ────────────────────
# 用于构建时读取追番/书籍收藏。配置后可以读取私有收藏条目，
# 并获得更高的 API 限流配额。留空则只显示公开收藏。
# 创建方式：bgm.tv → 个人设置 → 开发 → 创建 Access Token
BANGUMI_TOKEN=your_bangumi_token_here

# ── 第三方 AI API（可选） ───────────────────────────

# AI API Key：用于调用第三方 Embedding / Chat API
# 配置后走第三方 API（效果更好），不配则回退 Cloudflare Workers AI 免费模型
# 当前使用魔搭社区（ModelScope）的免费接口，注册即可获取
# 注册地址：https://modelscope.cn
# 获取方式：登录 → 右上角头像 → API-KEY 管理 → 创建 API Key
AI_API_KEY=your_api_key_here

# 允许调用 Worker AI 接口的站点来源，多个来源用英文逗号分隔
ALLOWED_ORIGINS=https://your-domain.example

# ── AI 解卦（卜筮页面，可选） ────────────────────────
# 卜筮页面的 AI 白话解卦功能。API Key 只存在服务端（Worker 环境变量），不会下发到前端。
# 两种配置方式（优先 DEEPSEEK_*）：
# 1) 复用上面的 AI_API_KEY（ModelScope 免费 Key）：不配置 DEEPSEEK_* 即自动走 ModelScope
# 2) 单独使用 DeepSeek 官方：注册 https://platform.deepseek.com 获取 API Key
DEEPSEEK_API_KEY=
# 可选的 API 地址与模型覆盖（默认 ModelScope 的 deepseek-ai/DeepSeek-V4-Flash）
# DEEPSEEK_API_URL=https://api.deepseek.com/v1
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---- 相册后台管理（又拍云） ----
# 管理口令 Bearer Token（自己生成的随机字符串）
GALLERY_ADMIN_TOKEN=
# 又拍云云存储服务名（Bucket）
UPYUN_BUCKET=
# 又拍云操作员名称
UPYUN_OPERATOR=
# 又拍云操作员密码
UPYUN_OPERATOR_PASSWORD=
# 又拍云表单 API 密钥
UPYUN_FORM_API_SECRET=
# 又拍云 CDN 访问域名，如 https://img.example.com
UPYUN_CDN_HOST=

# ---- 动态管理后台（数据与图片同样走又拍云） ----
# 管理口令 Bearer Token（自己生成的随机字符串，与相册后台相互独立）
DYNAMIC_ADMIN_TOKEN=

# ---- IndexNow（可选） ----------------------------------------
# 用于主动推送 URL 给 Bing/Yandex/Seznam/Naver 等搜索引擎
# 密钥需与 public/{key}.txt 文件名一致，文件内容为该密钥本身
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=your_indexnow_key_here
