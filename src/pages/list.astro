---
import { render } from "astro:content";
import * as path from "node:path";
import type { ImageMetadata } from "astro";
import PageTitle from "@/components/common/PageTitle.astro";
import ArticleList from "@/components/pages/ArticleList.svelte";
import { siteConfig } from "@/config";
import { coverImageConfig } from "@/config/coverImageConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import {
	getApiUrlList,
	processCoverImageSync,
	shouldAddNoReferrer,
} from "@/utils/image-utils";
import {
	getCategoryUrl,
	getFileDirFromPath,
	getPostUrlBySlug,
	getTagUrl,
	url,
} from "@/utils/url-utils";

const title = "文章列表";
const description = "按整页滚动浏览所有文章。";
const posts = await getSortedPosts();

const articleImageFiles = import.meta.glob<ImageMetadata>(
	"../**/*.{png,jpg,jpeg,webp,avif,gif}",
	{
		import: "default",
	},
);

async function resolveCoverImage(entry: (typeof posts)[number]) {
	const processedImage = processCoverImageSync(entry.data.image, entry.id);
	const coverApiUrls = getApiUrlList(entry.data.image, entry.id);

	if (!processedImage) {
		return {
			coverImage: "",
			coverApiUrls,
			coverReferrerPolicy: "",
		};
	}

	const isLocal = !(
		processedImage.startsWith("/") ||
		processedImage.startsWith("http") ||
		processedImage.startsWith("https") ||
		processedImage.startsWith("data:")
	);

	if (isLocal) {
		const basePath = getFileDirFromPath(entry.filePath || "");
		const normalizedPath = path
			.normalize(path.join("../", basePath, processedImage))
			.replace(/\\/g, "/");
		const imageFile = articleImageFiles[normalizedPath];

		if (!imageFile) {
			console.error(`[ERROR] Cover image not found: ${normalizedPath}`);
			return {
				coverImage: "",
				coverApiUrls,
				coverReferrerPolicy: "",
			};
		}

		const image = await imageFile();
		return {
			coverImage: image.src,
			coverApiUrls,
			coverReferrerPolicy: "",
		};
	}

	const coverImage = processedImage.startsWith("/")
		? url(processedImage)
		: processedImage;
	return {
		coverImage,
		coverApiUrls,
		coverReferrerPolicy: shouldAddNoReferrer(coverImage) ? "no-referrer" : "",
	};
}

const dateFormatter = new Intl.DateTimeFormat(
	siteConfig.lang.replace("_", "-"),
	{
		year: "numeric",
		month: "2-digit",
		day: "2-digit",
	},
);

const articleListPosts = await Promise.all(
	posts.map(async (entry) => {
		const { remarkPluginFrontmatter } = await render(entry);
		const { coverImage, coverApiUrls, coverReferrerPolicy } =
			await resolveCoverImage(entry);
		const rawCategory = entry.data.category?.trim();
		const category = rawCategory || i18n(I18nKey.uncategorized);
		const tags = (entry.data.tags || [])
			.map((tag) => tag.trim())
			.filter(Boolean)
			.map((tag) => ({
				name: tag,
				url: getTagUrl(tag),
			}));

		return {
			id: entry.id,
			title: entry.data.title,
			url: getPostUrlBySlug(entry.id),
			publishedIso: entry.data.published.toISOString(),
			publishedTimestamp: entry.data.published.getTime(),
			publishedText: dateFormatter.format(entry.data.published),
			category,
			categoryUrl: getCategoryUrl(rawCategory || null), // 或另一个，但必须唯一
			tags,
			description:
				entry.data.description ||
				remarkPluginFrontmatter.excerpt ||
				"暂无文章简介，点击查看完整内容。",
			pinned: !!entry.data.pinned,
			password: !!entry.data.password,
			coverImage,
			coverApiUrls,
			coverReferrerPolicy,
		};
	}),
);

const fallbackCoverImage = coverImageConfig.randomCoverImage.fallback
	? url(coverImageConfig.randomCoverImage.fallback)
	: "";

const umamiConfig = siteConfig.analytics?.umamiAnalytics;
const umamiPageviews = {
	enabled:
		!!umamiConfig?.pageviews?.enabled &&
		!!umamiConfig.shareId &&
		!!umamiConfig.scriptUrl,
	apiBase: umamiConfig?.scriptUrl ? new URL(umamiConfig.scriptUrl).origin : "",
	shareId: umamiConfig?.shareId || "",
};
---

<MainGridLayout title={title} description={description}>
	<section class="article-list-page">
		<header class="article-list-page__header">
			<PageTitle title={title} />
		</header>

		<ArticleList
			client:load
			posts={articleListPosts}
			postsPerPage={siteConfig.pagination.postsPerPage}
			umamiPageviews={umamiPageviews}
			fallbackCoverImage={fallbackCoverImage}
		/>
	</section>
</MainGridLayout>
