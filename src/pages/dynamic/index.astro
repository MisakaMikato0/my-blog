---
import DynamicFeed from "@/components/pages/dynamic/DynamicFeed.svelte";
import PageTitle from "@/components/common/PageTitle.astro";
import Icon from "@components/common/Icon.astro";
import { dynamicConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";
import "@/styles/pages/dynamic.css";

// 检查页面是否启用
if (!siteConfig.pages.dynamic) {
	return Astro.redirect("/404/");
}

const title = dynamicConfig.title || i18n(I18nKey.dynamic);
const description = dynamicConfig.description || i18n(I18nKey.dynamicDescription);
---

<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="dynamic-panel z-10 px-6 py-6 relative w-full">
			<div class="mb-4 flex items-center justify-between gap-4">
				<PageTitle title={title} variant="stacked" />
				<a
					href={url("/dynamic/admin/")}
					class="dynamic-admin-entry inline-flex shrink-0 items-center justify-center rounded-lg w-9 h-9 text-neutral-500 hover:text-(--primary) dark:text-neutral-400 dark:hover:text-(--primary) transition-colors"
					title={i18n(I18nKey.dynamicAdmin)}
					aria-label={i18n(I18nKey.dynamicAdmin)}
				>
					<Icon name="material-symbols:manage-accounts-rounded" class="text-xl" />
				</a>
			</div>

			<DynamicFeed client:load />
		</div>
	</div>
</MainGridLayout>
