---
import Icon from "@components/common/Icon.astro";
import { getApiUrlList } from "@/utils/image-utils";

// 文章封面 API：作为氛围背景层，overlay 混合进天气主题渐变（恢复背景图且不发灰）
const coverApis = getApiUrlList("api", "weather-widget");

// ===== 图标与数据配置（数据驱动渲染，避免重复模板） =====

// 主天气图标：meteocons 彩色天气图标（自带动画），构建期内联 SVG，
// 运行时按 weather_icon 代码 + 昼夜 切换显隐（data-icon 与脚本返回值一致）
const heroWeatherIcons = [
	"clear-day-fill",
	"clear-night-fill",
	"partly-cloudy-day-fill",
	"partly-cloudy-night-fill",
	"overcast-fill",
	"overcast-night-fill",
	"wind-fill",
	"hurricane-fill",
	"tornado-fill",
	"rain-fill",
	"thunderstorms-fill",
	"extreme-rain-fill",
	"drizzle-fill",
	"sleet-fill",
	"snow-fill",
	"fog-fill",
	"haze-fill",
	"dust-fill",
] as const;

interface ExtendedItem {
	/** 展示标签 */
	label: string;
	/** 数据回填用的 data-* 属性名（与脚本 setData 选择器保持一致） */
	attr: string;
	/** 加载前的占位文本 */
	placeholder: string;
	/** iconify 图标名：天气指标用 meteocons 彩色图标，通用项保留 lucide */
	icon: string;
	/** 图标颜色（仅对 currentColor 图标生效，meteocons 自带配色） */
	iconColor?: string;
	/** 空气质量卡片：数值 + 等级标签的特殊布局 */
	aqi?: boolean;
}

// 扩展数据卡片配置
const extendedItems: ExtendedItem[] = [
	{
		label: "体感",
		attr: "data-feels-like",
		placeholder: "--°C",
		icon: "meteocons:thermometer-fill",
	},
	{
		label: "湿度",
		attr: "data-humidity",
		placeholder: "--%",
		icon: "meteocons:humidity-fill",
	},
	{
		label: "风力",
		attr: "data-wind",
		placeholder: "--",
		icon: "meteocons:wind-fill",
	},
	{
		label: "降水概率",
		attr: "data-pop",
		placeholder: "--%",
		icon: "meteocons:umbrella-fill",
	},
	{
		label: "日出",
		attr: "data-sunrise",
		placeholder: "--:--",
		icon: "meteocons:sunrise-fill",
	},
	{
		label: "日落",
		attr: "data-sunset",
		placeholder: "--:--",
		icon: "meteocons:sunset-fill",
	},
	{
		label: "能见度",
		attr: "data-visibility",
		placeholder: "--km",
		icon: "lucide:eye",
		iconColor: "#cbd5e1",
	},
	{
		label: "气压",
		attr: "data-pressure",
		placeholder: "--hPa",
		icon: "meteocons:barometer-fill",
	},
	{
		label: "紫外线",
		attr: "data-uv",
		placeholder: "--",
		icon: "meteocons:uv-index-fill",
	},
	{
		label: "降水量",
		attr: "data-precipitation",
		placeholder: "--mm",
		icon: "meteocons:rain-fill",
	},
	{
		label: "云量",
		attr: "data-cloud",
		placeholder: "--%",
		icon: "meteocons:cloudy-fill",
	},
	{
		label: "空气质量",
		attr: "data-aqi",
		placeholder: "--",
		icon: "material-symbols:eco",
		iconColor: "#86efac",
		aqi: true,
	},
	// 污染物：颗粒物用 mdi 圆点/原子，气体用 mdi 分子，各配专属颜色
	{
		label: "PM2.5",
		attr: "data-pm25",
		placeholder: "--",
		icon: "mdi:blur",
		iconColor: "#7dd3fc",
	},
	{
		label: "PM10",
		attr: "data-pm10",
		placeholder: "--",
		icon: "mdi:atom",
		iconColor: "#5eead4",
	},
	{
		label: "O₃",
		attr: "data-o3",
		placeholder: "--",
		icon: "mdi:molecule",
		iconColor: "#86efac",
	},
	{
		label: "NO₂",
		attr: "data-no2",
		placeholder: "--",
		icon: "mdi:molecule",
		iconColor: "#fdba74",
	},
	{
		label: "SO₂",
		attr: "data-so2",
		placeholder: "--",
		icon: "mdi:molecule",
		iconColor: "#fde047",
	},
	{
		label: "CO",
		attr: "data-co",
		placeholder: "--",
		icon: "mdi:molecule",
		iconColor: "#fca5a5",
	},
];
---

<!--
	天气组件：基于 uapis.cn 天气接口（IP 自动定位）
	主图标使用 meteocons 彩色天气图标（自带动画），扩展指标中天气相关项也使用 meteocons，
	通用 UI 图标保留 lucide；背景按天气类型切换彩色渐变（深色高对比），
	构建期内联 SVG，运行时按 weather_icon 代码 + 昼夜切换显示。
-->
<section class="weather-widget" data-weather-init data-weather-theme="overcast" aria-label="天气预报">
	<!-- 背景图：封面 API 作为氛围层，overlay 混合进渐变背景（不影响可读性） -->
	{coverApis.length > 0 && (
		<div class="weather-widget__visual" aria-hidden="true">
			<img
				src={coverApis[0]}
				data-weather-cover
				data-api-urls={JSON.stringify(coverApis)}
				alt=""
				loading="lazy"
				decoding="async"
				referrerpolicy="no-referrer"
			/>
		</div>
	)}

	<!-- 加载状态 -->
	<div class="weather-widget__status weather-widget__status--loading" data-weather-loading>
		<div class="weather-widget__spinner" aria-hidden="true"></div>
		<span>加载中...</span>
	</div>

	<!-- 错误状态 -->
	<div class="weather-widget__status weather-widget__status--error weather-hidden" data-weather-error role="alert">
		<Icon name="lucide:triangle-alert" class="weather-widget__error-icon" is:inline />
		<span class="weather-widget__error-msg" data-error-message>加载失败</span>
		<button class="weather-widget__retry" type="button" data-retry-btn>
			<Icon name="lucide:refresh-cw" is:inline />重试
		</button>
	</div>

	<!-- 天气数据 -->
	<div class="weather-widget__content weather-hidden" data-weather-content>
		<div class="weather-widget__header">
			<div class="weather-widget__location">
				<Icon name="lucide:map-pin" class="weather-widget__loc-icon" is:inline />
				<span class="weather-widget__city" data-city>--</span>
				<span class="weather-widget__district" data-district>--</span>
			</div>
			<div class="weather-widget__big-icon" aria-hidden="true">
				{heroWeatherIcons.map((icon) => (
					<span class="weather-widget__icon-item weather-hidden" data-weather-icon data-icon={icon}>
						<Icon name={`meteocons:${icon}`} is:inline />
					</span>
				))}
			</div>
		</div>

		<div class="weather-widget__temp-row">
			<span class="weather-widget__temp" data-temperature>--</span>
			<span class="weather-widget__unit">°C</span>
			<span class="weather-widget__desc" data-weather>--</span>
		</div>

		<div class="weather-widget__range">
			<span class="weather-widget__range-min"><span data-temp-min>--</span>°</span>
			<span class="weather-widget__range-divider">/</span>
			<span class="weather-widget__range-max"><span data-temp-max>--</span>°</span>
			<span class="weather-widget__update">
				<Icon name="lucide:clock" is:inline />
				<span data-report-time>--</span>
			</span>
			<button class="weather-widget__retry weather-widget__retry--refresh" type="button" data-retry-btn title="刷新天气" aria-label="刷新天气">
				<Icon name="lucide:refresh-cw" is:inline />
			</button>
		</div>

		<div class="weather-widget__extended" data-weather-extended>
			{extendedItems.map((item) => (
				<div class:list={["weather-widget__item", item.aqi && "weather-widget__item--aqi"]}>
					<span class="weather-widget__item-icon" style={item.iconColor ? `color: ${item.iconColor}` : undefined}>
						<Icon name={item.icon} is:inline />
					</span>
					<span class="weather-widget__item-label">{item.label}</span>
					{item.aqi ? (
						<span class="weather-widget__item-value">
							<span data-aqi>--</span>
							<span class="aqi-tag" data-aqi-category>--</span>
						</span>
					) : (
						<span class="weather-widget__item-value" {...{ [item.attr]: "" }}>{item.placeholder}</span>
					)}
				</div>
			))}
		</div>
	</div>
</section>

<style>
	/* ===== 天气主题渐变：深色高对比背景，任何站点主题下都清晰 ===== */
	.weather-widget {
		/* 默认主题：阴天（蓝灰） */
		--wt-top: #64748b;
		--wt-bottom: #2d3646;
		--wt-glow: rgb(180 195 220 / 0.32);
		--wt-text: #fff;
		--wt-text-dim: rgb(255 255 255 / 0.74);
		--wt-panel: rgb(255 255 255 / 0.1);
		--wt-panel-border: rgb(255 255 255 / 0.18);
		position: relative;
		margin-top: var(--guide-gap);
		border: 1px solid rgb(255 255 255 / 0.22);
		border-radius: var(--guide-radius);
		background: linear-gradient(155deg, var(--wt-top), var(--wt-bottom) 72%);
		color: var(--wt-text);
		padding: clamp(1rem, 1.8vw, 1.6rem);
		overflow: hidden;
		isolation: isolate;
		transition: background 400ms ease;
	}

	/* 各天气主题配色 */
	.weather-widget[data-weather-theme="sunny"] {
		--wt-top: #d67c12;
		--wt-bottom: #b3550c;
		--wt-glow: rgb(255 214 120 / 0.5);
	}
	.weather-widget[data-weather-theme="partly"] {
		--wt-top: #4e7fc9;
		--wt-bottom: #27406f;
		--wt-glow: rgb(146 194 255 / 0.42);
	}
	.weather-widget[data-weather-theme="windy"] {
		--wt-top: #56989a;
		--wt-bottom: #28505a;
		--wt-glow: rgb(160 230 230 / 0.38);
	}
	.weather-widget[data-weather-theme="rainy"] {
		--wt-top: #4a78c9;
		--wt-bottom: #1c3355;
		--wt-glow: rgb(130 175 255 / 0.42);
	}
	.weather-widget[data-weather-theme="stormy"] {
		--wt-top: #5b4bb0;
		--wt-bottom: #221a4a;
		--wt-glow: rgb(170 140 255 / 0.42);
	}
	.weather-widget[data-weather-theme="snowy"] {
		--wt-top: #6593bd;
		--wt-bottom: #33506b;
		--wt-glow: rgb(220 240 255 / 0.48);
	}
	.weather-widget[data-weather-theme="sleety"] {
		--wt-top: #6f87ae;
		--wt-bottom: #2d4058;
		--wt-glow: rgb(200 220 250 / 0.42);
	}
	.weather-widget[data-weather-theme="foggy"] {
		--wt-top: #6f7780;
		--wt-bottom: #343940;
		--wt-glow: rgb(210 215 225 / 0.32);
	}
	.weather-widget[data-weather-theme="hazy"] {
		--wt-top: #a37e5e;
		--wt-bottom: #4e3827;
		--wt-glow: rgb(240 200 160 / 0.38);
	}
	.weather-widget[data-weather-theme="dusty"] {
		--wt-top: #b3924e;
		--wt-bottom: #5d481f;
		--wt-glow: rgb(240 215 150 / 0.38);
	}

	/* 夜间：压暗冷调，突出月亮/星空图标 */
	.weather-widget[data-weather-night="true"] {
		background: linear-gradient(155deg, color-mix(in srgb, var(--wt-top) 42%, #141b2b), var(--wt-bottom));
	}

	/* 顶部光晕装饰 */
	.weather-widget::before {
		content: "";
		position: absolute;
		top: -32%;
		right: -12%;
		width: 72%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle, var(--wt-glow), transparent 66%);
		pointer-events: none;
		z-index: 0;
	}

	/* ===== 背景图：封面 API 氛围层 =====
		overlay 混合模式把图片色彩"烧进"渐变背景：既有背景图质感又不会发灰，
		深色渐变仍保证文字对比度；hover 时轻微放大提亮 */
	.weather-widget__visual {
		position: absolute;
		inset: 0;
		z-index: 0;
		opacity: 0.34;
		pointer-events: none;
		overflow: hidden;
		mix-blend-mode: overlay;
	}

	.weather-widget__visual img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		filter: brightness(0.86) saturate(1.15);
		transition: transform 240ms ease, opacity 240ms ease;
	}

	.weather-widget:hover .weather-widget__visual img,
	.weather-widget:focus-within .weather-widget__visual img {
		transform: scale(1.06) translateX(1.5%);
		opacity: 0.85;
	}

	.weather-hidden {
		display: none !important;
	}

	/* ===== 状态：加载 / 错误 ===== */
	.weather-widget__status,
	.weather-widget__content {
		position: relative;
		z-index: 1;
	}

	.weather-widget__status {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		min-height: 6rem;
		font-size: 0.88rem;
		font-weight: 750;
		color: var(--wt-text-dim);
	}

	.weather-widget__spinner {
		width: 2rem;
		height: 2rem;
		border: 2px solid rgb(255 255 255 / 0.28);
		border-top-color: #fff;
		border-radius: 50%;
		animation: weather-widget-spin 0.8s linear infinite;
	}

	@keyframes weather-widget-spin {
		to {
			transform: rotate(360deg);
		}
	}

	.weather-widget__error-icon {
		color: #ff9d9d;
		font-size: 2rem;
	}

	.weather-widget__error-msg {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		max-width: 100%;
	}

	.weather-widget__retry {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.4rem;
		padding: 0.375rem 0.85rem;
		border: 1px solid rgb(255 255 255 / 0.36);
		border-radius: 0.5rem;
		background: rgb(255 255 255 / 0.12);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 850;
		cursor: pointer;
		transition:
			transform 160ms ease,
			background-color 160ms ease;
	}

	.weather-widget__retry:hover {
		transform: translateY(-1px);
		background: rgb(255 255 255 / 0.24);
	}

	.weather-widget__retry svg {
		width: 1em;
		height: 1em;
	}

	/* ===== 内容区 ===== */
	.weather-widget__content {
		display: flex;
		flex-direction: column;
		gap: clamp(0.9rem, 1.6vw, 1.3rem);
		text-shadow: 0 1px 10px rgb(0 0 0 / 0.2);
		animation: weather-widget-fade-in 0.5s ease both;
	}

	@keyframes weather-widget-fade-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 头部：位置 + 大图标 */
	.weather-widget__header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.weather-widget__location {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.3rem;
		min-width: 0;
	}

	.weather-widget__loc-icon {
		color: var(--wt-text-dim);
		font-size: 1rem;
		flex: none;
	}

	.weather-widget__city,
	.weather-widget__district {
		font-size: clamp(0.95rem, 1.2vw, 1.1rem);
		font-weight: 800;
		line-height: 1.2;
	}

	.weather-widget__district {
		color: var(--wt-text-dim);
		font-weight: 650;
	}

	/* 大图标：玻璃拟态圆形托盘 + 浮动动画 */
	.weather-widget__big-icon {
		flex: none;
		display: grid;
		place-items: center;
		width: clamp(4.6rem, 6.5vw, 6.2rem);
		height: clamp(4.6rem, 6.5vw, 6.2rem);
		border-radius: 50%;
		background: radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.3), rgb(255 255 255 / 0.07) 70%);
		border: 1px solid rgb(255 255 255 / 0.4);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.28),
			0 12px 28px rgb(0 0 0 / 0.28);
		backdrop-filter: blur(6px);
		animation: weather-widget-float 3s ease-in-out infinite;
	}

	/* meteocons 图标自带配色；512 画布含留白，放大补偿实际可见尺寸 */
	.weather-widget__big-icon svg {
		width: auto;
		height: clamp(2.6rem, 3.8vw, 3.4rem);
		display: block;
		filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.3));
	}

	@keyframes weather-widget-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	.weather-widget__icon-item {
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	/* 温度行 */
	.weather-widget__temp-row {
		display: flex;
		align-items: baseline;
		gap: 0.3rem;
	}

	.weather-widget__temp {
		font-size: clamp(2.6rem, 4.2vw, 3.6rem);
		font-weight: 950;
		line-height: 1;
	}

	.weather-widget__unit {
		font-size: clamp(0.9rem, 1.3vw, 1.1rem);
		font-weight: 750;
		color: var(--wt-text-dim);
		position: relative;
		top: -0.8rem;
	}

	.weather-widget__desc {
		margin-left: 0.4rem;
		font-size: clamp(1.1rem, 1.8vw, 1.5rem);
		font-weight: 800;
	}

	/* 最高/最低 + 更新时间 + 刷新 */
	.weather-widget__range {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.88rem;
		font-weight: 800;
	}

	.weather-widget__range-min {
		color: #a6ccff;
	}

	.weather-widget__range-max {
		color: #ffb8a6;
	}

	.weather-widget__range-divider {
		color: var(--wt-text-dim);
	}

	.weather-widget__update {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--wt-text-dim);
		opacity: 0.85;
	}

	.weather-widget__update svg {
		width: 0.9em;
		height: 0.9em;
	}

	.weather-widget__retry--refresh {
		display: inline-grid;
		place-items: center;
		margin-top: 0;
		padding: 0.28rem;
		border-radius: 50%;
		border: 1px solid rgb(255 255 255 / 0.32);
		background: rgb(255 255 255 / 0.1);
		font-size: 0.85rem;
		line-height: 1;
	}

	.weather-widget__retry--refresh:hover {
		background: rgb(255 255 255 / 0.22);
	}

	.weather-widget__retry--refresh svg {
		width: 0.9em;
		height: 0.9em;
	}

	/* 扩展数据网格：玻璃拟态面板 */
	.weather-widget__extended {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.55rem;
		border-top: 1px solid rgb(255 255 255 / 0.18);
		padding-top: 0.9rem;
	}

	.weather-widget__item {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		min-width: 0;
		padding: 0.55rem 0.7rem;
		border: 1px solid var(--wt-panel-border);
		border-radius: 0.6rem;
		background: var(--wt-panel);
		backdrop-filter: blur(6px);
		transition:
			border-color 160ms ease,
			background-color 160ms ease,
			transform 160ms ease;
	}

	.weather-widget__item:hover {
		border-color: rgb(255 255 255 / 0.42);
		background: rgb(255 255 255 / 0.17);
		transform: translateY(-1px);
	}

	/* 扩展卡片图标：半透明圆底托盘，统一视觉（污染物/通用图标走 currentColor 上色） */
	.weather-widget__item-icon {
		display: inline-grid;
		place-items: center;
		width: 1.9em;
		height: 1.9em;
		border-radius: 0.55em;
		background: rgb(255 255 255 / 0.14);
		border: 1px solid rgb(255 255 255 / 0.22);
		margin-bottom: 0.15rem;
	}

	.weather-widget__item-icon svg {
		width: auto;
		height: 1.1em;
		color: #fff;
	}

	/* meteocons 小图标同样有画布留白，放大以与 lucide 视觉一致 */
	.weather-widget__item-icon svg[data-icon^="meteocons:"] {
		height: 1.5em;
	}

	.weather-widget__item-label {
		font-size: 0.66rem;
		font-weight: 850;
		letter-spacing: 0.08em;
		color: var(--wt-text-dim);
	}

	.weather-widget__item-value {
		font-size: 0.88rem;
		font-weight: 900;
		line-height: 1.2;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 空气质量单元格：数值 + 等级标签 */
	.weather-widget__item--aqi .weather-widget__item-value {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	/* AQI 等级标签 */
	.aqi-tag {
		display: inline-block;
		padding: 0.08rem 0.5rem;
		border-radius: 999px;
		font-size: 0.68rem;
		font-weight: 900;
		line-height: 1.4;
		white-space: nowrap;
	}

	.aqi-good {
		background: #22c55e;
		color: #fff;
	}

	.aqi-moderate {
		background: #eab308;
		color: #111;
	}

	.aqi-bad {
		background: #ef4444;
		color: #fff;
	}

	@media (max-width: 1200px) {
		.weather-widget__extended {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.weather-widget__extended {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		.weather-widget__header {
			flex-direction: column;
			align-items: flex-start;
		}

		.weather-widget__big-icon {
			align-self: flex-end;
			margin-top: -3.2rem;
		}

		.weather-widget__update {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.weather-widget__spinner,
		.weather-widget__big-icon,
		.weather-widget__content {
			animation: none;
		}
	}
</style>

<script>
	interface ForecastDay {
		sunrise?: string;
		sunset?: string;
		pop?: number | string;
	}

	interface WeatherData {
		city?: string;
		district?: string;
		temperature?: number | string;
		weather?: string;
		wind_direction?: string;
		wind_power?: string;
		humidity?: number | string;
		report_time?: string;
		temp_max?: number | string;
		temp_min?: number | string;
		weather_icon?: string;
		feels_like?: number | string;
		visibility?: number | string;
		pressure?: number | string;
		uv?: number | string;
		precipitation?: number | string;
		cloud?: number | string;
		forecast?: ForecastDay[];
		aqi?: number | string;
		aqi_category?: string;
		aqi_level?: number;
		air_pollutants?: Record<string, number | string | undefined>;
	}

	const city = undefined;
	const adcode = undefined;
	const CACHE_KEY = "weather_data_cache";
	const CACHE_DURATION = 1800000;
	const extended = true;

	const API_URL = "https://uapis.cn/api/v1/misc/weather?";

	// 天气图标映射：和风天气标准编码 → meteocons 基础形态（组件内已预渲染，
	// 运行时再根据昼夜取具体的 day/night 图标）
	const WEATHER_ICON_MAP: Record<string, string> = {
		// 晴
		"100": "clear",
		// 多云 / 少云 / 晴间多云
		"101": "partly-cloudy",
		"102": "partly-cloudy",
		"103": "partly-cloudy",
		// 阴
		"104": "overcast",
		// 风（200-209 风力等级，210-212 飓风，213 龙卷风）
		"200": "wind",
		"201": "wind",
		"202": "wind",
		"203": "wind",
		"204": "wind",
		"205": "wind",
		"206": "wind",
		"207": "wind",
		"208": "wind",
		"209": "wind",
		"210": "hurricane",
		"211": "hurricane",
		"212": "hurricane",
		"213": "tornado",
		// 雨
		"300": "rain",
		"301": "rain",
		"302": "thunderstorms",
		"303": "thunderstorms",
		"304": "thunderstorms",
		"305": "rain",
		"306": "rain",
		"307": "rain",
		"308": "extreme-rain",
		"309": "drizzle",
		"310": "extreme-rain",
		"311": "extreme-rain",
		"312": "extreme-rain",
		"313": "sleet",
		"314": "rain",
		"315": "rain",
		"316": "extreme-rain",
		"317": "extreme-rain",
		"318": "extreme-rain",
		"319": "rain",
		"320": "rain",
		"321": "rain",
		"322": "rain",
		"323": "extreme-rain",
		"324": "extreme-rain",
		"325": "sleet",
		"326": "sleet",
		"399": "rain",
		// 雪
		"400": "snow",
		"401": "snow",
		"402": "snow",
		"403": "snow",
		"404": "sleet",
		"405": "sleet",
		"406": "sleet",
		"407": "snow",
		"408": "snow",
		"409": "snow",
		"410": "snow",
		"499": "snow",
		// 雾 / 霾 / 沙尘
		"500": "fog",
		"501": "fog",
		"502": "haze",
		"503": "dust",
		"504": "dust",
		"507": "dust",
		"508": "dust",
		"509": "fog",
		"510": "fog",
		"511": "haze",
		"512": "haze",
		"513": "haze",
		"514": "fog",
		"515": "fog",
		// 热 / 冷
		"900": "clear",
		"901": "snow",
	};

	// 白天图标（通用形态）
	const DAY_ICON_NAMES: Record<string, string> = {
		clear: "clear-day-fill",
		"partly-cloudy": "partly-cloudy-day-fill",
		overcast: "overcast-fill",
		wind: "wind-fill",
		hurricane: "hurricane-fill",
		tornado: "tornado-fill",
		rain: "rain-fill",
		thunderstorms: "thunderstorms-fill",
		"extreme-rain": "extreme-rain-fill",
		drizzle: "drizzle-fill",
		sleet: "sleet-fill",
		snow: "snow-fill",
		fog: "fog-fill",
		haze: "haze-fill",
		dust: "dust-fill",
	};

	// 夜间图标（仅昼夜差异明显的形态；雨/雪/雷等夜间样式与白天近似，复用白天图标）
	const NIGHT_ICON_NAMES: Record<string, string> = {
		clear: "clear-night-fill",
		"partly-cloudy": "partly-cloudy-night-fill",
		overcast: "overcast-night-fill",
	};

	function getWeatherIcon(weatherIcon: string, isNight: boolean): string {
		const base = WEATHER_ICON_MAP[weatherIcon] || "overcast";
		if (isNight && NIGHT_ICON_NAMES[base]) return NIGHT_ICON_NAMES[base];
		return DAY_ICON_NAMES[base] || "overcast-fill";
	}

	// 根据日出/日落时间判断昼夜；数据缺失时按本地时间兜底
	function isNightTime(data: WeatherData): boolean {
		const now = new Date();
		const nowMinutes = now.getHours() * 60 + now.getMinutes();
		const today = data.forecast?.[0];
		if (today?.sunrise && today?.sunset) {
			const toMinutes = (time: string): number => {
				const [h, m] = time.split(":").map(Number);
				if (!Number.isFinite(h) || !Number.isFinite(m)) return NaN;
				return h * 60 + m;
			};
			const sunrise = toMinutes(today.sunrise);
			const sunset = toMinutes(today.sunset);
			if (Number.isFinite(sunrise) && Number.isFinite(sunset)) {
				return nowMinutes < sunrise || nowMinutes >= sunset;
			}
		}
		const hour = now.getHours();
		return hour < 6 || hour >= 19;
	}

	// 天气主题：背景渐变配色（base 与 WEATHER_ICON_MAP 的基础形态一致）
	const WEATHER_THEME_MAP: Record<string, string> = {
		clear: "sunny",
		"partly-cloudy": "partly",
		overcast: "overcast",
		wind: "windy",
		hurricane: "windy",
		tornado: "windy",
		rain: "rainy",
		thunderstorms: "stormy",
		"extreme-rain": "rainy",
		drizzle: "rainy",
		sleet: "sleety",
		snow: "snowy",
		fog: "foggy",
		haze: "hazy",
		dust: "dusty",
	};

	function getWeatherTheme(weatherIcon: string): string {
		const base = WEATHER_ICON_MAP[weatherIcon] || "overcast";
		return WEATHER_THEME_MAP[base] || "overcast";
	}

	function readCache(key: string): WeatherData | null {
		try {
			const raw = localStorage.getItem(key);
			if (!raw) return null;
			const entry = JSON.parse(raw);
			if (!entry || typeof entry.timestamp !== "number") return null;
			if (Date.now() - entry.timestamp > CACHE_DURATION) return null;
			return entry.data;
		} catch {
			return null;
		}
	}

	// 获取天气数据 - 支持 IP 自动定位
	async function fetchWeather(): Promise<WeatherData> {
		const params = new URLSearchParams();
		if (adcode) {
			params.set("adcode", adcode);
		} else if (city) {
			params.set("city", city);
		}
		// 如果都没传，不传任何参数，让接口自动根据 IP 定位
		if (extended) {
			params.set("extended", "true");
		}
		// 添加 forecast=true 获取最高/最低温度
		params.set("forecast", "true");

		// 只有指定了城市或 adcode 时才缓存，IP 自动定位不缓存
		// 因为 IP 可能会变化（切换网络、VPN 等）
		const cacheKey = adcode ? `adcode_${adcode}` : city ? `city_${city}` : "";
		if (cacheKey) {
			const cached = readCache(CACHE_KEY + cacheKey);
			if (cached) return cached;
		}

		const url = API_URL + params.toString();
		const response = await fetch(url);

		if (!response.ok) {
			throw new Error(`请求失败: ${response.status}`);
		}

		const data = (await response.json()) as WeatherData;

		if (cacheKey) {
			try {
				localStorage.setItem(
					CACHE_KEY + cacheKey,
					JSON.stringify({ data, timestamp: Date.now() }),
				);
			} catch {
				// 忽略存储错误
			}
		}

		return data;
	}

	// 图标组件为构建期内联 SVG，无法运行时改 name，改为按代码切换显示
	function setWeatherIcon(container: HTMLElement, weatherIcon: string, isNight: boolean) {
		const iconName = getWeatherIcon(weatherIcon, isNight);
		container.querySelectorAll<HTMLElement>("[data-weather-icon]").forEach((el) => {
			el.classList.toggle("weather-hidden", el.dataset.icon !== iconName);
		});
	}

	// 用户偏好减少动态效果时，暂停 meteocons 自带的 SMIL 动画
	function respectReducedMotion(container: HTMLElement) {
		if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		container.querySelectorAll<SVGSVGElement>("svg").forEach((svg) => {
			try {
				svg.pauseAnimations();
			} catch {
				// 忽略不支持 pauseAnimations 的环境
			}
		});
	}

	// 封面背景图：按顺序重试 API，全部失败则隐藏背景层（天气数据不受影响）
	function initWeatherCover(container: HTMLElement) {
		const img = container.querySelector<HTMLImageElement>("[data-weather-cover]");
		if (!img) return;

		let urls: string[] = [];
		try {
			urls = JSON.parse(img.dataset.apiUrls || "[]");
		} catch {
			urls = [];
		}

		let index = 1; // 0 号已由服务端设为 src
		const onError = () => {
			if (index < urls.length) {
				img.addEventListener("error", onError, { once: true });
				img.src = urls[index];
				index += 1;
			} else {
				img.closest(".weather-widget__visual")?.classList.add("weather-hidden");
			}
		};

		if (img.complete) {
			if (img.naturalWidth === 0) onError();
		} else {
			img.addEventListener("error", onError, { once: true });
		}
	}

	// 更新 UI
	function updateUI(container: HTMLElement, data: WeatherData | null, error: string | null = null) {
		const loading = container.querySelector("[data-weather-loading]");
		const errorEl = container.querySelector("[data-weather-error]");
		const content = container.querySelector("[data-weather-content]");
		const errorMsg = container.querySelector("[data-error-message]");

		// 隐藏加载状态
		loading?.classList.add("weather-hidden");

		if (error) {
			// 如果有错误，显示错误信息，但不隐藏已有的内容
			errorEl?.classList.remove("weather-hidden");
			if (errorMsg) errorMsg.textContent = error;
			// 保留服务端渲染的内容（如果有的话）
			return;
		}

		if (!data) {
			// 如果没有数据也没有错误，不做任何操作
			return;
		}

		// 隐藏错误状态
		errorEl?.classList.add("weather-hidden");

		// 更新数据
		const setData = (selector: string, value: unknown) => {
			const el = container.querySelector(selector);
			if (el) el.textContent = value == null || value === "" ? "--" : String(value);
		};

		setData("[data-city]", data.city);
		setData("[data-district]", data.district);
		setData("[data-temperature]", data.temperature);
		setData("[data-weather]", data.weather);
		setData("[data-wind]", `${data.wind_direction} ${data.wind_power}`);
		setData("[data-humidity]", `${data.humidity}%`);
		setData("[data-report-time]", data.report_time);

		// 更新最高/最低温度
		setData("[data-temp-max]", data.temp_max != null ? String(data.temp_max) : "--");
		setData("[data-temp-min]", data.temp_min != null ? String(data.temp_min) : "--");

		// 昼夜判断（图标与背景主题共用）
		const isNight = isNightTime(data);

		// 更新天气图标（按天气代码 + 昼夜）
		setWeatherIcon(container, data.weather_icon ?? "", isNight);

		// 更新背景主题：天气类型 → 彩色渐变，夜间额外压暗
		container.dataset.weatherTheme = getWeatherTheme(data.weather_icon ?? "");
		container.dataset.weatherNight = isNight ? "true" : "";

		// 更新扩展数据
		const extendedSection = container.querySelector("[data-weather-extended]");
		if (extendedSection) {
			// 从 forecast 数组中获取日出日落时间
			const todayForecast = data.forecast && data.forecast.length > 0 ? data.forecast[0] : null;

			setData("[data-feels-like]", data.feels_like != null ? `${data.feels_like}°C` : "--°C");
			setData("[data-visibility]", data.visibility != null ? `${data.visibility}km` : "--km");
			setData("[data-pressure]", data.pressure != null ? `${data.pressure}hPa` : "--hPa");
			setData("[data-uv]", data.uv != null ? String(data.uv) : "--");
			setData("[data-precipitation]", data.precipitation != null ? `${data.precipitation}mm` : "--mm");
			setData("[data-cloud]", data.cloud != null ? `${data.cloud}%` : "--%");
			setData("[data-sunrise]", todayForecast?.sunrise || "--:--");
			setData("[data-sunset]", todayForecast?.sunset || "--:--");
			// 降水概率（从 forecast 获取）
			setData("[data-pop]", todayForecast?.pop != null ? `${todayForecast.pop}%` : "--%");

			// 空气质量
			const aqiEl = container.querySelector("[data-aqi]");
			const aqiCategoryEl = container.querySelector("[data-aqi-category]");
			if (data.aqi != null) {
				if (aqiEl) aqiEl.textContent = String(data.aqi);
				if (aqiCategoryEl) {
					aqiCategoryEl.textContent = data.aqi_category || "--";
					// 根据空气质量等级添加样式
					aqiCategoryEl.className = "aqi-tag";
					if (data.aqi_level === 1) aqiCategoryEl.classList.add("aqi-good");
					else if (data.aqi_level === 2) aqiCategoryEl.classList.add("aqi-moderate");
					else if ((data.aqi_level ?? 0) >= 3) aqiCategoryEl.classList.add("aqi-bad");
				}
			} else {
				if (aqiEl) aqiEl.textContent = "--";
				if (aqiCategoryEl) aqiCategoryEl.textContent = "--";
			}

			// 污染物浓度
			const pollutants = data.air_pollutants || {};
			setData("[data-pm25]", pollutants.pm25 != null ? `${pollutants.pm25}` : "--");
			setData("[data-pm10]", pollutants.pm10 != null ? `${pollutants.pm10}` : "--");
			setData("[data-o3]", pollutants.o3 != null ? `${pollutants.o3}` : "--");
			setData("[data-no2]", pollutants.no2 != null ? `${pollutants.no2}` : "--");
			setData("[data-so2]", pollutants.so2 != null ? `${pollutants.so2}` : "--");
			setData("[data-co]", pollutants.co != null ? `${pollutants.co}` : "--");
		}

		// 显示内容
		content?.classList.remove("weather-hidden");
		respectReducedMotion(container);
	}

	// 初始化组件
	function initWidget(container: HTMLElement): (() => void) | undefined {
		if (container.dataset.weatherReady === "true") return;
		container.dataset.weatherReady = "true";

		initWeatherCover(container);

		const retryBtns = Array.from(container.querySelectorAll("[data-retry-btn]"));
		const content = container.querySelector("[data-weather-content]");
		const loading = container.querySelector("[data-weather-loading]");
		const errorEl = container.querySelector("[data-weather-error]");

		async function loadWeather() {
			// 显示加载状态，隐藏其他状态
			loading?.classList.remove("weather-hidden");
			errorEl?.classList.add("weather-hidden");
			content?.classList.add("weather-hidden");

			try {
				const data = await fetchWeather();
				updateUI(container, data);
			} catch (e) {
				updateUI(container, null, e.message || "获取天气信息失败");
			}
		}

		// 重试按钮 - 清除缓存后重新加载
		const onRetry = () => {
			const cacheKey = adcode ? `adcode_${adcode}` : city ? `city_${city}` : "ip_location";
			localStorage.removeItem(CACHE_KEY + cacheKey);
			loadWeather();
		};
		retryBtns.forEach((btn) => btn.addEventListener("click", onRetry));

		// 自动加载天气数据（基于用户浏览器 IP 定位）
		loadWeather();

		return () => {
			retryBtns.forEach((btn) => btn.removeEventListener("click", onRetry));
		};
	}

	// SWUP 无刷新切换页面时的初始化与清理
	const cleanups: Array<() => void> = [];
	function initWeatherWidgets() {
		document.querySelectorAll<HTMLElement>("[data-weather-init]").forEach((container) => {
			const cleanup = initWidget(container);
			if (cleanup) cleanups.push(cleanup);
		});
	}
	function cleanupWeatherWidgets() {
		cleanups.forEach((fn) => fn());
		cleanups.length = 0;
	}

	initWeatherWidgets();
	document.addEventListener("astro:page-load", initWeatherWidgets);
	document.addEventListener("astro:before-swap", cleanupWeatherWidgets);
</script>
